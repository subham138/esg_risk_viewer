<%- include('../templates/header.ejs') %>

<div class="container-fluid">
  <div class="page-header">
    <div class="row align-items-center">
      <div class="col-sm-6">
        <h3 class="mb-1"><i class="icofont icofont-file-alt me-2 text-primary"></i><%= header %></h3>
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
          <li class="breadcrumb-item active">VSME Templates</li>
        </ol>
      </div>
      <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
        <a href="/admin/vsme-templates/create" class="btn btn-primary btn-air-primary px-4 py-2">
          <i class="icofont icofont-plus me-1"></i> Add New Template
        </a>
      </div>
    </div>
  </div>
</div>

<div class="container-fluid">
  <div class="row">
    <div class="col-sm-12">
      <% if (message) { %>
        <div class="alert alert-<%= message.type === 'danger' ? 'danger' : (message.type === 'success' ? 'success' : 'info') %> alert-dismissible fade show" role="alert">
          <i class="icofont <%= message.type === 'success' ? 'icofont-check-circled' : 'icofont-exclamation-tringle' %> me-2 fs-5"></i>
          <strong><%= message.message %></strong>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom">
          <h5 class="card-title mb-0 fw-bold text-secondary">
            <i class="icofont icofont-list me-2"></i>Template Versions Overview
          </h5>
          <small class="text-muted">Displays the latest version for each template lineage.</small>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover align-middle" id="basic-1">
              <thead class="table-light">
                <tr>
                  <th scope="col" style="width: 50px;">#</th>
                  <th scope="col">Template Name</th>
                  <th scope="col">Lineage ID</th>
                  <th scope="col">Version</th>
                  <th scope="col">Status</th>
                  <th scope="col">Hierarchy Summary</th>
                  <th scope="col">Created At</th>
                  <th scope="col" class="text-end" style="width: 120px;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% if (templates && templates.length > 0) { %>
                  <% templates.forEach((item, index) => { %>
                    <tr>
                      <td class="fw-semibold"><%= index + 1 %></td>
                      <td>
                        <span class="fw-bold text-dark d-block"><%= item.template_name %></span>
                        <div class="mt-1">
                          <% if (item.supported_languages && item.supported_languages.length > 0) { %>
                            <% item.supported_languages.forEach(lang => { %>
                              <span class="badge bg-light text-primary border me-1"><%= lang.toUpperCase() %></span>
                            <% }); %>
                          <% } %>
                        </div>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border">LINEAGE-<%= item.lineage_id || item.id %></span>
                      </td>
                      <td>
                        <span class="badge bg-info text-white">v<%= item.version_number %>.0</span>
                      </td>
                      <td>
                        <% if (item.is_published === 1) { %>
                          <span class="badge bg-success"><i class="icofont icofont-check me-1"></i>Published</span>
                        <% } else { %>
                          <span class="badge bg-warning text-dark"><i class="icofont icofont-edit-alt me-1"></i>Draft</span>
                        <% } %>
                      </td>
                      <td>
                        <small class="text-secondary">
                          <i class="icofont icofont-folder-open me-1 text-primary"></i><strong><%= item.category_count || 0 %></strong> Categories &bull; 
                          <i class="icofont icofont-sub-listing me-1 text-info"></i><strong><%= item.label_count || 0 %></strong> Labels &bull; 
                          <i class="icofont icofont-question-square me-1 text-success"></i><strong><%= item.question_count || 0 %></strong> Questions
                        </small>
                      </td>
                      <td>
                        <small class="text-muted"><%= item.created_at ? new Date(item.created_at).toLocaleDateString() : 'N/A' %></small>
                      </td>
                      <td class="text-end">
                        <div class="btn-group" role="group">
                          <a href="/vsme/questionnaire?template_id=<%= item.id %>" class="btn btn-sm btn-outline-success rounded-pill px-3 me-1" data-bs-toggle="tooltip" title="Open Slide Questionnaire">
                            <i class="icofont icofont-presentation me-1"></i> Questionnaire
                          </a>
                          <a href="/admin/vsme-templates/edit/<%= item.id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3" data-bs-toggle="tooltip" title="Edit Template Configuration">
                            <i class="icofont icofont-ui-edit me-1"></i> Edit
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="8" class="text-center py-5 text-muted">
                      <i class="icofont icofont-folder-search fs-1 text-muted d-block mb-2"></i>
                      No VSME templates configured yet. Click <strong>"Add New Template"</strong> to create one.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../templates/footer.ejs') %>
