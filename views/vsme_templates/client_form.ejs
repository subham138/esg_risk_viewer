  function handleMultiInputChange(qId, rIdx, val) {
    const qObj = findQuestionById(qId);
    const currentVal = answerStore[qId] ? answerStore[qId].answer_val : '';
    let multiArr = parseMultipleAnswers(currentVal, qObj ? qObj.input_type : 'string', qObj ? qObj.has_value_input : false);

    while (multiArr.length <= rIdx) {
      multiArr.push('');
