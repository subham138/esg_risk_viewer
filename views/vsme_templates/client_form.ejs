  // Auto-Save & Draft Save Persistence
  function markDirty() {
    isDirty = true;
    autoSaveBadge.className = 'vsme-status-badge saving';
    autoSaveText.innerText = 'Unsaved changes...';

    // Debounce auto-save after 3 seconds
    if (autoSaveTimer) clearTimeout(autoSaveTimer);
    autoSaveTimer = setTimeout(() => {
      saveDraftAjax(true);
    }, 3000);
  }

  function setupIdleDetection() {
    const resetIdleTimer = () => {
      if (idleTimer) clearTimeout(idleTimer);
      idleTimer = setTimeout(() => {
        if (isDirty) {
          saveDraftAjax(true);
        }
      }, 15000); // 15 seconds of idle inactivity
    };

    ['mousemove', 'keydown', 'scroll', 'touchstart'].forEach(evt => {
      document.addEventListener(evt, resetIdleTimer, { passive: true });
    });
  }

  async function saveDraftAjax(isSilent = false) {
    if (!isDirty && isSilent) return;

    if (!isSilent) {
      autoSaveBadge.className = 'vsme-status-badge saving';
      autoSaveText.innerText = 'Saving draft...';
    }

    try {
      const payload = {
        template_id: rawTemplate.id,
        project_id: projectId,
        selected_language: currentLanguage,
        answers: answerStore,
        classified_sections: classifiedStore
      };

      const response = await fetch('/vsme/save-draft', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const res = await response.json();
      if (res.success) {
        isDirty = false;
        autoSaveBadge.className = 'vsme-status-badge saved';
        autoSaveText.innerText = `Saved at ${res.last_saved || 'now'}`;
      } else {
        autoSaveBadge.className = 'vsme-status-badge';
        autoSaveText.innerText = 'Error saving';
      }
    } catch (err) {
      console.error('Error in saveDraftAjax:', err);
      autoSaveBadge.className = 'vsme-status-badge';
      autoSaveText.innerText = 'Offline / Retrying';
    }
  }

  async function submitFinalAjax() {
    // Validate all URL questions across the template
    for (let c of (rawTemplate.categories || [])) {
      for (let l of (c.labels || [])) {
        if (classifiedStore[l.id] || isFirstQuestionNo(l)) continue;
        for (let q of (l.questions || [])) {
          if (q.input_type === 'url' && answerStore[q.id] && answerStore[q.id].answer_val) {
            if (isMultipleAllowed(q)) {
              const multiArr = parseMultipleAnswers(answerStore[q.id].answer_val, 'url', false);
              const hasInvalid = multiArr.some(item => item && String(item).trim() !== '' && !isValidHttpUrl(String(item).trim()));
              if (hasInvalid) {
                const modalElem = document.getElementById('submitModal');
                if (modalElem) {
                  const modal = bootstrap.Modal.getInstance(modalElem);
                  if (modal) modal.hide();
                }
                showToastNotification(`Invalid URL format in question: "${getLocalized(q.question_translations, q.question_en)}". Please fix it before submitting.`, 'danger');
                return;
              }
            } else {
              const val = String(answerStore[q.id].answer_val).trim();
              if (val !== '' && !isValidHttpUrl(val)) {
                const modalElem = document.getElementById('submitModal');
                if (modalElem) {
                  const modal = bootstrap.Modal.getInstance(modalElem);
                  if (modal) modal.hide();
                }
                showToastNotification(`Invalid URL format in question: "${getLocalized(q.question_translations, q.question_en)}". Please fix it before submitting.`, 'danger');
                return;
              }
            }
          }
        }
      }
    }

    const btn = document.getElementById('btnConfirmSubmit');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Submitting...';

    try {
      const payload = {
        template_id: rawTemplate.id,
        project_id: projectId,
        selected_language: currentLanguage,
        flag: '<%= typeof flag !== "undefined" ? flag : "RVY%3D" %>',
        answers: answerStore,
        classified_sections: classifiedStore
      };

      const response = await fetch('/vsme/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const res = await response.json();
      if (res.success) {
        window.location.href = res.redirect || '/admin/vsme-templates';
      } else {
        alert(res.message || 'Error submitting questionnaire');
        btn.disabled = false;
        btn.innerText = 'Confirm & Submit';
      }
    } catch (err) {
      console.error('Error in submitFinalAjax:', err);
      alert('Server error while submitting questionnaire.');
      btn.disabled = false;
      btn.innerText = 'Confirm & Submit';
    }
  }

  async function exportExcelAjax() {
    const btn = document.getElementById('btnExportExcel');
    const origHtml = btn ? btn.innerHTML : '';
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1 text-success"></span> Exporting...';
    }

    try {
      const payload = {
        template_id: rawTemplate.id,
        project_id: projectId,
        selected_language: currentLanguage,
        answers: answerStore,
        classified_sections: classifiedStore
      };

      const response = await fetch('/vsme/generate-excel', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const res = await response.json();
      if (res.success) {
        showToastNotification(`Excel template populated successfully (${res.totalPopulated} values populated). Starting download...`, 'success');
        const downloadLink = document.createElement('a');
        downloadLink.href = `/vsme/export-excel?template_id=${rawTemplate.id}&project_id=${projectId}`;
        downloadLink.download = res.fileName || 'VSME_Report.xlsx';
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);
      } else {
        showToastNotification(res.message || 'Error exporting Excel template', 'danger');
      }
    } catch (err) {
      console.error('Error in exportExcelAjax:', err);
      showToastNotification('Server error while generating Excel file.', 'danger');
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = origHtml;
      }
    }
  }

  function setupEventListeners() {
    // Nav buttons
    document.getElementById('btnNextSlide').addEventListener('click', advanceNextQuestion);
    document.getElementById('btnPrevSlide').addEventListener('click', advancePrevQuestion);
    const btnSkip = document.getElementById('btnSkipQuestion');
    if (btnSkip) {
      btnSkip.addEventListener('click', skipCurrentQuestion);
    }

    // Save & Export buttons
    document.getElementById('btnManualDraftSave').addEventListener('click', () => saveDraftAjax(false));
    const btnExport = document.getElementById('btnExportExcel');
    if (btnExport) {
      btnExport.addEventListener('click', exportExcelAjax);
    }
    document.getElementById('btnFinalSubmit').addEventListener('click', () => {
      const modal = new bootstrap.Modal(document.getElementById('submitModal'));
      modal.show();
    });
    document.getElementById('btnConfirmSubmit').addEventListener('click', submitFinalAjax);

    // Language buttons
    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentLanguage = btn.getAttribute('data-lang');

        // Dynamic update of all labels, categories, and question texts without page reload!
        document.querySelectorAll('.cat-tab-title').forEach(el => {
          el.innerText = el.getAttribute(`data-${currentLanguage}`) || el.getAttribute('data-en');
        });
        renderActiveSlide();
      });
    });

    // Version selector
    const verSel = document.getElementById('versionSelector');
    if (verSel) {
      verSel.addEventListener('change', (e) => {
        window.location.href = `/vsme/questionnaire?template_id=${e.target.value}&project_id=${projectId}&lang=${currentLanguage}`;
      });
    }

    // Stepper Ribbon Scroll Arrow Buttons
    const track = document.getElementById('horizontalStepperTrack');
    const btnStripLeft = document.getElementById('btnStripScrollLeft');
    const btnStripRight = document.getElementById('btnStripScrollRight');

    if (btnStripLeft && track) {
      btnStripLeft.addEventListener('click', () => {
        track.scrollBy({ left: -260, behavior: 'smooth' });
        setTimeout(updateStripNavArrows, 320);
      });
    }
    if (btnStripRight && track) {
      btnStripRight.addEventListener('click', () => {
        track.scrollBy({ left: 260, behavior: 'smooth' });
        setTimeout(updateStripNavArrows, 320);
      });
    }
    if (track) {
      track.addEventListener('scroll', updateStripNavArrows, { passive: true });
    }

    // Enter key inside input fields
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey && e.target && e.target.classList && e.target.classList.contains('vsme-input-control') && e.target.tagName !== 'TEXTAREA') {
        const qIdAttr = e.target.getAttribute('data-qid');
        const isMultiRow = e.target.hasAttribute('data-row-idx');
        if (isMultiRow && qIdAttr) {
          const qIdNum = parseInt(qIdAttr, 10);
          const qObj = findQuestionById(qIdNum);
          if (qObj && isMultipleAllowed(qObj)) {
            e.preventDefault();
            addMultiAnswerRow(qIdNum);
            return;
          }
        }
        e.preventDefault();
        advanceNextQuestion();
      } else if (e.altKey && e.key === 'ArrowRight') {
        e.preventDefault();
        advanceNextQuestion();
      } else if (e.altKey && e.key === 'ArrowLeft') {
        e.preventDefault();
        advancePrevQuestion();
      } else if (e.altKey && (e.key === 's' || e.key === 'S')) {
        e.preventDefault();
        skipCurrentQuestion();
      }
    });
  }

  function initStickyStepper() {
    const card = document.getElementById('hStepperCard');
    const placeholder = document.getElementById('hStepperPlaceholder');
    const wrapper = document.getElementById('fullStageWrapper');
    if (!card || !placeholder || !wrapper) return;

    function updateStickyPosition() {
      const headerEl = document.querySelector('.page-main-header');
      const headerHeight = headerEl ? headerEl.offsetHeight : 80;
      const placeholderRect = placeholder.getBoundingClientRect();
      const cardRect = card.getBoundingClientRect();
      const wrapperRect = wrapper.getBoundingClientRect();

      const isCurrentlySticky = card.classList.contains('vsme-sticky-active');
      const checkTop = isCurrentlySticky ? placeholderRect.top : cardRect.top;

      if (checkTop <= headerHeight) {
        if (!isCurrentlySticky) {
          placeholder.style.height = `${card.offsetHeight}px`;
          placeholder.style.marginBottom = '5px';
          placeholder.style.display = 'block';
          card.classList.add('vsme-sticky-active');
        }
        card.style.left = `${wrapperRect.left}px`;
        card.style.width = `${wrapperRect.width}px`;
        card.style.top = `${headerHeight}px`;
      } else {
        if (isCurrentlySticky) {
          card.classList.remove('vsme-sticky-active');
          placeholder.style.display = 'none';
          card.style.left = '';
          card.style.width = '';
          card.style.top = '';
        }
      }
    }

    window.addEventListener('scroll', updateStickyPosition, { passive: true });
    window.addEventListener('resize', updateStickyPosition, { passive: true });
    document.querySelectorAll('#sidebar-toggle, .toggle-sidebar, .lang-btn, .vsme-cat-tab-btn').forEach(el => {
      el.addEventListener('click', () => setTimeout(updateStickyPosition, 250));
    });

    // Initial check
    setTimeout(updateStickyPosition, 100);
  }
</script>

