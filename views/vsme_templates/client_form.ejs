  function findQuestionById(qId) {
    for (let c of (rawTemplate.categories || [])) {
      for (let l of (c.labels || [])) {
        for (let q of (l.questions || [])) {
          if (q.id === qId) return q;
        }
      }
    }
    return null;
  }

  // Real-time Formula Evaluation Engine
  function evaluateFormulas() {
    evaluateCellCopying();
    if (!rawTemplate.categories) return;

    rawTemplate.categories.forEach(c => {
      (c.labels || []).forEach(l => {
        (l.questions || []).forEach(q => {
          if (q.input_type === 'calculated' && q.formula_config) {
            const op = q.formula_config.formula_type || q.formula_config.operation || 'sum';
            const sourceCells = q.formula_config.source_cells || [];
            let result = 0;

            const values = sourceCells.map(cellRef => {
              const srcQ = findQuestionByCell(cellRef);
              if (srcQ && answerStore[srcQ.id] && answerStore[srcQ.id].answer_val) {
                const ansRaw = answerStore[srcQ.id].answer_val;
                if (typeof ansRaw === 'string' && ansRaw.startsWith('[')) {
                  try {
                    const parsed = JSON.parse(ansRaw);
                    if (Array.isArray(parsed)) {
                      const numArr = parsed.map(v => parseFloat(v)).filter(n => !isNaN(n));
                      return numArr.length > 0 ? numArr.reduce((a, b) => a + b, 0) : 0;
                    }
                  } catch (e) {}
                }
                const num = parseFloat(ansRaw);
                return isNaN(num) ? 0 : num;
              }
              return 0;
            });

            if (op === 'sum') {
              result = values.reduce((acc, v) => acc + v, 0);
            } else if (op === 'subtract') {
              result = values.length > 0 ? values.reduce((acc, v, i) => i === 0 ? v : acc - v, values[0]) : 0;
            } else if (op === 'multiply') {
              result = values.reduce((acc, v) => acc * v, 1);
            } else if (op === 'divide') {
              result = values[1] && values[1] !== 0 ? (values[0] / values[1]) : 0;
            }

            const calcDisplay = document.getElementById(`calcDisplay_${q.id}`);
            if (calcDisplay) {
              calcDisplay.innerText = result.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
            answerStore[q.id] = {
              ...answerStore[q.id],
              question_id: q.id,
              excel_cell_ref: q.excel_cell_ref || '',
              answer_val: String(result),
              calculated_val: String(result),
              category_id: c.id,
              label_id: l.id,
              sheet_name: c.sheet_name || ''
            };
          }
        });
      });
    });
  }

  // Real-time Cell Value Auto-Copy & Sync Engine
  function evaluateCellCopying() {
    if (!rawTemplate.categories) return;

    rawTemplate.categories.forEach(c => {
      (c.labels || []).forEach(l => {
        (l.questions || []).forEach(q => {
          // Single Question Copy Evaluation
          const copyCfg = q.copy_config || (q.formula_config ? q.formula_config.copy_config : null);
          if (copyCfg && copyCfg.parent_cell_ref) {
            const parentCell = copyCfg.parent_cell_ref.trim();
            const parentQ = findQuestionByCell(parentCell);
            if (parentQ && answerStore[parentQ.id] && answerStore[parentQ.id].answer_val !== undefined) {
              const parentVal = answerStore[parentQ.id].answer_val;
              const currentChildVal = answerStore[q.id] ? answerStore[q.id].answer_val : '';
              const isReadOnly = copyCfg.access_mode === 'readonly';

              if (parentVal !== null && parentVal !== undefined && parentVal !== '') {
                if (isReadOnly || !currentChildVal || q.last_auto_copied_val === currentChildVal) {
                  if (currentChildVal !== parentVal) {
                    q.last_auto_copied_val = parentVal;
                    answerStore[q.id] = {
                      ...answerStore[q.id],
                      question_id: q.id,
                      excel_cell_ref: q.excel_cell_ref || '',
                      answer_val: parentVal,
                      category_id: c.id,
                      label_id: l.id,
                      sheet_name: c.sheet_name || ''
                    };

                    updateQuestionDomInput(q, parentVal, isReadOnly);
                  }
                }
              }
            }
          }

          // Dynamic Grid / Table Question Column Copy Evaluation
          if (q.input_type === 'table' && q.table_config && Array.isArray(q.table_config.columns)) {
            let tableRowsData = [];
            let isTableModified = false;
            const currentTableRaw = answerStore[q.id] ? answerStore[q.id].answer_val : '';
            try {
              tableRowsData = typeof currentTableRaw === 'string' && currentTableRaw ? JSON.parse(currentTableRaw) : (Array.isArray(currentTableRaw) ? currentTableRaw : []);
            } catch (e) {
              tableRowsData = [];
            }

            const initialRowCount = q.table_config.initial_rows && q.table_config.initial_rows > 0 ? q.table_config.initial_rows : 1;
            if (tableRowsData.length === 0) {
              for (let r = 0; r < initialRowCount; r++) tableRowsData.push({});
            }

            q.table_config.columns.forEach((col, colIdx) => {
              const colCopyCfg = col.copy_config;
              if (!colCopyCfg || !colCopyCfg.parent_cell_ref) return;

              const parentRef = colCopyCfg.parent_cell_ref.trim();
              const isReadOnly = colCopyCfg.access_mode === 'readonly';
              const colKey = getColumnKey(col, colIdx);

              const cellList = expandCellReferencePattern(parentRef);

              tableRowsData.forEach((rowObj, rIdx) => {
                const targetRef = cellList.length > 0 ? (cellList[rIdx] || cellList[cellList.length - 1]) : parentRef;
                const parentVal = fetchCellValueByReference(targetRef, rIdx);

                if (parentVal !== null && parentVal !== undefined && parentVal !== '') {
                  const currentCellVal = rowObj[colKey] !== undefined && rowObj[colKey] !== null ? String(rowObj[colKey]) : '';
                  const lastCopiedKey = `last_copied_${colKey}_${rIdx}`;
                  const lastCopiedVal = q[lastCopiedKey];

                  if (isReadOnly || !currentCellVal || lastCopiedVal === currentCellVal) {
                    if (currentCellVal !== parentVal) {
                      rowObj[colKey] = parentVal;
                      q[lastCopiedKey] = parentVal;
                      isTableModified = true;

                      updateTableCellDomInput(q.id, rIdx, colKey, parentVal, isReadOnly);
                    }
                  }
                }
              });
            });

            if (isTableModified) {
              answerStore[q.id] = {
                ...answerStore[q.id],
                question_id: q.id,
                excel_cell_ref: q.excel_cell_ref || '',
                answer_val: JSON.stringify(tableRowsData),
                category_id: c.id,
                label_id: l.id,
                sheet_name: c.sheet_name || ''
              };

              evaluateTableSummaries(q.id);
            }
          }
        });
      });
    });
  }

  function expandCellReferencePattern(rawRef) {
    if (!rawRef) return [];
    let clean = String(rawRef).trim();
    if (clean.includes('!')) {
      const parts = clean.split('!');
      clean = parts[1].trim();
    }
    const rangeMatch = clean.match(/^([A-Z]+)(\d+):([A-Z]+)(\d+)$/i);
    if (rangeMatch) {
      const colLetter1 = rangeMatch[1].toUpperCase();
      const startRow = parseInt(rangeMatch[2], 10);
      const colLetter2 = rangeMatch[3].toUpperCase();
      const endRow = parseInt(rangeMatch[4], 10);
      if (colLetter1 === colLetter2 && !isNaN(startRow) && !isNaN(endRow) && startRow <= endRow) {
        const result = [];
        for (let r = startRow; r <= endRow; r++) {
          result.push(`${colLetter1}${r}`);
        }
        return result;
      }
    }
    if (clean.includes(',')) {
      return clean.split(',').map(s => s.trim()).filter(s => s.length > 0);
    }
    return [rawRef.trim()];
  }

  function fetchCellValueByReference(targetCellRef, rIdx) {
    if (!targetCellRef) return null;
    const parentQ = findQuestionByCell(targetCellRef);
    if (!parentQ || !answerStore[parentQ.id] || answerStore[parentQ.id].answer_val === undefined) {
      return null;
    }

    const rawVal = answerStore[parentQ.id].answer_val;
    if (rawVal === null || rawVal === undefined || rawVal === '') return '';

    if (parentQ.input_type === 'table') {
      try {
        const parentTableRows = typeof rawVal === 'string' ? JSON.parse(rawVal) : rawVal;
        if (Array.isArray(parentTableRows) && parentTableRows[rIdx]) {
          const parentRow = parentTableRows[rIdx];
          const cleanRef = targetCellRef.includes('!') ? targetCellRef.split('!')[1].trim().toUpperCase() : targetCellRef.trim().toUpperCase();
          if (parentQ.table_config && Array.isArray(parentQ.table_config.columns)) {
            for (let pIdx = 0; pIdx < parentQ.table_config.columns.length; pIdx++) {
              const pCol = parentQ.table_config.columns[pIdx];
              const pColKey = getColumnKey(pCol, pIdx);
              if (pCol.excel_cell) {
                const pCells = expandCellReferencePattern(pCol.excel_cell);
                if (pCells.map(c => c.toUpperCase()).includes(cleanRef) || pCol.excel_cell.toUpperCase().includes(cleanRef)) {
                  return parentRow[pColKey] !== undefined ? String(parentRow[pColKey]) : '';
                }
              }
            }
            const firstDataCol = parentQ.table_config.columns.find(c => c.type !== 'row_id');
            if (firstDataCol) {
              const fColKey = getColumnKey(firstDataCol, 0);
              return parentRow[fColKey] !== undefined ? String(parentRow[fColKey]) : '';
            }
          }
        }
      } catch (e) {}
      return '';
    }

    if (typeof rawVal === 'string' && rawVal.startsWith('[')) {
      try {
        const parsedArr = JSON.parse(rawVal);
        if (Array.isArray(parsedArr) && parsedArr.length > 0) {
          const item = parsedArr[rIdx] !== undefined ? parsedArr[rIdx] : parsedArr[0];
          return typeof item === 'object' && item !== null ? (item.dropdown || item.val || '') : String(item || '');
        }
      } catch (e) {}
    }

    return String(rawVal);
  }

  function updateTableCellDomInput(qId, rIdx, colKey, value, isReadOnly) {
    const tbody = document.getElementById(`tableBody_${qId}`);
    if (!tbody) return;
    const rowEl = tbody.querySelector(`tr[data-row-idx="${rIdx}"]`);
    if (!rowEl) return;
    const inputEl = rowEl.querySelector(`[data-col-id="${colKey}"]`);
    if (!inputEl) return;

    if (inputEl.value !== value) {
      inputEl.value = value;
    }

    if (isReadOnly) {
      inputEl.readOnly = true;
      if (inputEl.tagName === 'SELECT') inputEl.disabled = true;
      inputEl.classList.add('bg-light');
    }
  }

  function updateQuestionDomInput(q, value, isReadOnly) {
    const inputEls = document.querySelectorAll(`[name="q_${q.id}"], #input_${q.id}, [data-qid="${q.id}"] input, [data-qid="${q.id}"] select, [data-qid="${q.id}"] textarea`);
    inputEls.forEach(inputEl => {
      if (inputEl.type === 'checkbox') {
        inputEl.checked = (value === 'true' || value === '1' || value === 'Yes' || value === 'TRUE');
      } else {
        inputEl.value = value;
      }
      if (isReadOnly) {
        inputEl.readOnly = true;
        if (inputEl.tagName === 'SELECT') inputEl.disabled = true;
        inputEl.classList.add('bg-light');
      }
    });

    if (q.input_type === 'boolean') {
      const boolContainer = document.querySelector(`.vsme-segmented-bool[data-qid="${q.id}"]`);
      if (boolContainer) {
        const btns = boolContainer.querySelectorAll('.vsme-seg-btn');
        btns.forEach(btn => {
          btn.classList.remove('active-yes', 'active-no');
          if ((value === 'TRUE' || value === 'true' || value === 'Yes') && btn.innerText.trim() === 'Yes') btn.classList.add('active-yes');
          if ((value === 'FALSE' || value === 'false' || value === 'No') && btn.innerText.trim() === 'No') btn.classList.add('active-no');
          if (value === 'N/A' && btn.innerText.trim() === 'N/A') btn.classList.add('active-no');
          if (isReadOnly) btn.style.pointerEvents = 'none';
        });
      }
    }
  }

  function findQuestionByCell(rawCellRef) {
    if (!rawCellRef) return null;
    let targetSheet = null;
    let targetCell = String(rawCellRef).trim();

    // Check if reference includes a sheet specification e.g. Sheet4!D3 or 'Sheet4'!D3
    if (targetCell.includes('!')) {
      const parts = targetCell.split('!');
      targetSheet = parts[0].trim().replace(/^'|'$/g, '').toLowerCase();
      targetCell = parts[1].trim();
    }

    const cleanTargetCell = targetCell.toUpperCase();

    // First pass: match with targetSheet filter if provided
    for (let c of (rawTemplate.categories || [])) {
      if (targetSheet) {
        const catSheetName = (c.sheet_name || '').trim().toLowerCase();
        const catName = (c.name_en || '').trim().toLowerCase();
        if (catSheetName !== targetSheet && catName !== targetSheet) {
          continue;
        }
      }

      for (let l of (c.labels || [])) {
        for (let q of (l.questions || [])) {
          if (q.excel_cell_ref) {
            const cellRefsArr = q.excel_cell_ref.split(',').map(r => r.trim().toUpperCase());
            if (cellRefsArr.includes(cleanTargetCell)) {
              return q;
            }
          }
        }
      }
    }

    // Fallback pass: search across all categories if sheet match wasn't specified or exact sheet match failed
    for (let c of (rawTemplate.categories || [])) {
      for (let l of (c.labels || [])) {
        for (let q of (l.questions || [])) {
          if (q.excel_cell_ref) {
            const cellRefsArr = q.excel_cell_ref.split(',').map(r => r.trim().toUpperCase());
            if (cellRefsArr.includes(cleanTargetCell)) {
              return q;
            }
          }
        }
      }
    }

    return null;
  }

  // Conditional Visibility Engine
  // Conditional Visibility & Skip Logic Engine
  function evaluateVisibility() {
    if (!rawTemplate.categories) return;

    rawTemplate.categories.forEach(c => {
      (c.labels || []).forEach(l => {
        (l.questions || []).forEach(q => {
          const card = document.getElementById(`qCard_${q.id}`);
          if (!card) return;

          const isSkipped = isQuestionSkipped(q, l);
          const skipBanner = document.getElementById(`skipBanner_${q.id}`);
          const skipBadge = document.getElementById(`skipBadge_${q.id}`);
          const multiBadge = document.getElementById(`multiBadge_${q.id}`);
          const qBody = document.getElementById(`qBody_${q.id}`);

          // Keep question card VISIBLE so user can see skipped questions
          card.style.display = 'block';

          if (isSkipped) {
            card.classList.add('vsme-q-card-skipped');
            if (skipBanner) skipBanner.classList.remove('d-none');
            if (skipBadge) skipBadge.classList.remove('d-none');
            if (multiBadge) multiBadge.classList.add('d-none');
            if (qBody) qBody.style.cssText = 'opacity: 0.45; pointer-events: none;';

            // Disable all inputs inside skipped question card
            card.querySelectorAll('input, select, textarea, button').forEach(el => {
              if (el.classList.contains('vsme-q-info-btn')) return;
              el.disabled = true;
              if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') el.readOnly = true;
            });
          } else {
            card.classList.remove('vsme-q-card-skipped');
            if (skipBanner) skipBanner.classList.add('d-none');
            if (skipBadge) skipBadge.classList.add('d-none');
            if (multiBadge) multiBadge.classList.remove('d-none');

            const copyCfg = q.copy_config || (q.formula_config ? q.formula_config.copy_config : null);
            const isCopyReadOnly = copyCfg && copyCfg.parent_cell_ref && copyCfg.access_mode === 'readonly';

            if (!isCopyReadOnly) {
              if (qBody) qBody.style.cssText = 'opacity: 1; pointer-events: auto;';
              card.querySelectorAll('input, select, textarea, button').forEach(el => {
                if (el.classList.contains('vsme-q-info-btn')) return;
                if (el.classList.contains('table-cell-input')) {
                  const colKey = el.getAttribute('data-col-id');
                  if (colKey && q.table_config && Array.isArray(q.table_config.columns)) {
                    const colObj = q.table_config.columns.find((col, cIdx) => getColumnKey(col, cIdx) === colKey);
                    if (colObj && colObj.copy_config && colObj.copy_config.parent_cell_ref && colObj.copy_config.access_mode === 'readonly') {
                      return;
                    }
                  }
                }
                el.disabled = false;
                if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') el.readOnly = false;
              });
            }
          }
        });
      });
    });
  }

  // Navigation & Carousel Controls
  function jumpToQuestion(qIdx) {
    const questions = activeLabel ? (activeLabel.questions || []) : [];
    if (qIdx >= 0 && qIdx < questions.length) {
      activeQuestionIndex = qIdx;
      renderSlideStage();
      updateNavButtons();
    }
  }

  function updateLiveTrackerPills() {
    if (!activeLabel || !activeLabel.questions) return;
    const pills = document.querySelectorAll('.vsme-q-pill-btn');
    
    activeLabel.questions.forEach((q, idx) => {
      const pill = pills[idx];
      if (!pill) return;
      
      const filled = isQuestionFilled(q);
      const isSkipped = isQuestionSkipped(q, activeLabel);
      const isActive = (idx === activeQuestionIndex);
      const disp = getQuestionDisplayInfo(q, activeLabel);
      
      let pillClass = 'vsme-q-pill-btn';
      if (isActive) pillClass += ' active';
      if (isSkipped) pillClass += ' skipped';
      else if (filled) pillClass += ' filled';
      if (disp.isChild) pillClass += ' vsme-q-pill-child';
      pill.className = pillClass;
      
      const dot = pill.querySelector('.vsme-q-pill-dot');
      if (dot) {
        if (isSkipped) {
          dot.innerHTML = '<i class="icofont icofont-ban"></i>';
        } else if (filled) {
          dot.innerHTML = '<i class="icofont icofont-check"></i>';
        } else {
          dot.innerHTML = disp.numStr;
        }
      }

      const span = pill.querySelector('span:not(.vsme-q-pill-dot)');
      if (span) {
        span.innerHTML = `${disp.pillStr}${isSkipped ? ' <small style="opacity: 0.8;">(Skipped)</small>' : ''}`;
      }
    });

    renderHorizontalStepper();
    updateOverallProgress();
    updateNavButtons();
  }

  function advanceNextSlide() {
    advanceNextQuestion();
  }

  function advancePrevSlide() {
    advancePrevQuestion();
  }

  function advanceNextQuestion() {
    const questions = activeLabel ? (activeLabel.questions || []) : [];
    if (questions.length === 0) {
      advanceNextSection();
      return;
    }

    // Validate current question if it is a URL input and has a value
    const currentQ = questions[activeQuestionIndex];
    if (currentQ && currentQ.input_type === 'url' && !isQuestionSkipped(currentQ, activeLabel)) {
      const a = answerStore[currentQ.id];
      if (a && a.answer_val) {
        if (isMultipleAllowed(currentQ)) {
          const multiArr = parseMultipleAnswers(a.answer_val, 'url', false);
          const hasInvalid = multiArr.some(item => item && String(item).trim() !== '' && !isValidHttpUrl(String(item).trim()));
          if (hasInvalid) {
            showToastNotification('Please enter a valid URL format (e.g., https://example.com) before proceeding.', 'warning');
            return;
          }
        } else {
          const raw = String(a.answer_val).trim();
          if (raw !== '' && !isValidHttpUrl(raw)) {
            showToastNotification('Please enter a valid URL format (e.g., https://example.com) before proceeding.', 'warning');
            const inputEl = document.querySelector(`input[data-qid="${currentQ.id}"]`);
            if (inputEl) {
              inputEl.classList.add('is-invalid');
              inputEl.focus();
            }
            return;
          }
        }
      }
    }

    // If Q1 was answered No, skip Q2 & Q3 and proceed directly to next section
    if (isFirstQuestionNo(activeLabel) && activeQuestionIndex === 0) {
      advanceNextSection();
      return;
    }

    // Find next non-skipped question index in this section
    let nextIdx = activeQuestionIndex + 1;
    while (nextIdx < questions.length && isQuestionSkipped(questions[nextIdx], activeLabel)) {
      nextIdx++;
    }

    if (nextIdx < questions.length) {
      activeQuestionIndex = nextIdx;
      renderSlideStage();
      updateNavButtons();
    } else {
      advanceNextSection();
    }
  }

  function advanceNextSection() {
    const totalLabels = (activeCategory.labels || []).length;
    if (activeLabelIndex < totalLabels - 1) {
      activeLabelIndex++;
      activeQuestionIndex = 0;
      renderActiveSlide();
    } else if (activeCatIndex < rawTemplate.categories.length - 1) {
      activeCatIndex++;
      activeLabelIndex = 0;
      activeQuestionIndex = 0;
      updateCategoryTabActive();
      renderActiveSlide();
    } else {
      // Final slide: open submit modal
      const modal = new bootstrap.Modal(document.getElementById('submitModal'));
      modal.show();
    }
  }

  function advancePrevQuestion() {
    const questions = activeLabel ? (activeLabel.questions || []) : [];
    let prevIdx = activeQuestionIndex - 1;

    while (prevIdx >= 0 && isQuestionSkipped(questions[prevIdx], activeLabel)) {
      prevIdx--;
    }

    if (prevIdx >= 0) {
      activeQuestionIndex = prevIdx;
      renderSlideStage();
      updateNavButtons();
    } else {
      advancePrevSection();
    }
  }

  function advancePrevSection() {
    if (activeLabelIndex > 0) {
      activeLabelIndex--;
      const prevLbl = activeCategory.labels[activeLabelIndex];
      const prevQuestions = prevLbl ? (prevLbl.questions || []) : [];
      if (isFirstQuestionNo(prevLbl)) {
        activeQuestionIndex = 0; // Land on Q1 since Q2/Q3 were skipped
      } else {
        // Land on the last non-skipped question in the previous section
        let lastValidIdx = prevQuestions.length - 1;
        while (lastValidIdx > 0 && isQuestionSkipped(prevQuestions[lastValidIdx], prevLbl)) {
          lastValidIdx--;
        }
        activeQuestionIndex = Math.max(0, lastValidIdx);
      }
      renderActiveSlide();
    } else if (activeCatIndex > 0) {
      activeCatIndex--;
      const prevCat = rawTemplate.categories[activeCatIndex];
      activeLabelIndex = Math.max(0, (prevCat.labels || []).length - 1);
      const prevLbl = prevCat.labels[activeLabelIndex];
      const prevQuestions = prevLbl ? (prevLbl.questions || []) : [];
      if (isFirstQuestionNo(prevLbl)) {
        activeQuestionIndex = 0;
      } else {
        let lastValidIdx = prevQuestions.length - 1;
        while (lastValidIdx > 0 && isQuestionSkipped(prevQuestions[lastValidIdx], prevLbl)) {
          lastValidIdx--;
        }
        activeQuestionIndex = Math.max(0, lastValidIdx);
      }
      updateCategoryTabActive();
      renderActiveSlide();
    }
  }

  function skipCurrentQuestion() {
    advanceNextQuestion();
  }

  function updateNavButtons() {
    const btnPrev = document.getElementById('btnPrevSlide');
    const btnNext = document.getElementById('btnNextSlide');
    const btnSkip = document.getElementById('btnSkipQuestion');
    const questions = activeLabel ? (activeLabel.questions || []) : [];
    const totalQ = questions.length;
    const lblTitle = getLocalized(activeLabel.name_translations, activeLabel.name_en || '');
    const currentQ = questions[activeQuestionIndex];
    const isSkipped = isQuestionSkipped(currentQ, activeLabel);
    const isQ1No = isFirstQuestionNo(activeLabel);
    const currentDisp = getQuestionDisplayInfo(currentQ, activeLabel);

    if (totalQ > 0) {
      if (isSkipped) {
        slideCounterText.innerText = `Question ${currentDisp.numStr} of ${totalQ} (Skipped) in ${lblTitle}`;
      } else if (isQ1No && activeQuestionIndex === 0 && totalQ > 1) {
        slideCounterText.innerText = `Question 1 of ${totalQ} in ${lblTitle} (Q2 & Q3 Skipped)`;
      } else if (currentDisp.isChild) {
        slideCounterText.innerText = `Question ${currentDisp.numStr} (Follow-up to Q${currentDisp.parentNumStr}) in ${lblTitle}`;
      } else {
        slideCounterText.innerText = `Question ${currentDisp.numStr} of ${totalQ} in ${lblTitle}`;
      }
    } else {
      slideCounterText.innerText = `${lblTitle}`;
    }

    btnPrev.disabled = (activeCatIndex === 0 && activeLabelIndex === 0 && activeQuestionIndex === 0);

    const isLastLabel = (activeCatIndex === rawTemplate.categories.length - 1 && activeLabelIndex === (activeCategory.labels || []).length - 1);

    // Check if there are any remaining non-skipped questions after activeQuestionIndex in this label
    let hasNextNonSkippedInLabel = false;
    for (let k = activeQuestionIndex + 1; k < totalQ; k++) {
      if (!isQuestionSkipped(questions[k], activeLabel)) {
        hasNextNonSkippedInLabel = true;
        break;
      }
    }

    const isLastQ = !hasNextNonSkippedInLabel || (isQ1No && activeQuestionIndex === 0);

    if (isLastLabel && isLastQ) {
      btnNext.innerHTML = 'Review & Submit <i class="icofont icofont-check-circled ms-1"></i>';
      btnNext.className = 'btn btn-success vsme-nav-btn';
    } else if (isLastQ) {
      btnNext.innerHTML = 'Next Section <i class="icofont icofont-arrow-right ms-1"></i>';
      btnNext.className = 'btn btn-primary vsme-nav-btn';
    } else {
      btnNext.innerHTML = 'Next Question <i class="icofont icofont-arrow-right ms-1"></i>';
      btnNext.className = 'btn btn-primary vsme-nav-btn';
    }

    if (btnSkip) {
      btnSkip.style.display = (isLastLabel && isLastQ) ? 'none' : 'inline-flex';
    }
  }

  function updateCategoryTabActive() {
    const catBtns = document.querySelectorAll('.vsme-cat-tab-btn');
    catBtns.forEach((b, idx) => {
      if (idx === activeCatIndex) b.classList.add('active');
      else b.classList.remove('active');
    });
  }

  function updateOverallProgress() {
    let totalQuestions = 0;
    let totalAnswered = 0;

    (rawTemplate.categories || []).forEach(c => {
      let catQ = 0;
      let catAns = 0;
      (c.labels || []).forEach(l => {
        const isClassified = classifiedStore[l.id];
        const isQ1No = isFirstQuestionNo(l);
        (l.questions || []).forEach(q => {
          totalQuestions++;
          catQ++;
          if (isClassified || isQ1No || isQuestionFilled(q) || isQuestionSkipped(q, l)) {
            totalAnswered++;
            catAns++;
          }
        });
      });
      const badge = document.getElementById(`catBadge_${c.id}`);
      if (badge) badge.innerText = `${catAns}/${catQ}`;
    });

    const percent = Math.min(100, Math.round((totalAnswered / Math.max(1, totalQuestions)) * 100));
    progressBarFill.style.width = `${percent}%`;
    progressStatsText.innerText = `${percent}% Completed (${totalAnswered}/${totalQuestions} Answered)`;
  }

  // Toggle Question Inline Guidance Box
  function toggleQuestionInlineInfo(qId) {
    const banner = document.getElementById(`qInfoBanner_${qId}`);
    const pillBtn = document.getElementById(`infoPillBtn_${qId}`);
    if (banner) {
      if (banner.style.display === 'none') {
        banner.style.display = 'block';
        if (pillBtn) pillBtn.classList.add('active');
      } else {
        banner.style.display = 'none';
        if (pillBtn) pillBtn.classList.remove('active');
      }
    }
  }

  // Guidance Drawer Trigger
