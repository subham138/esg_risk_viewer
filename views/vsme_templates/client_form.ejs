  function handleMultiDropdownChange(qId, rIdx, selectElem, hasCustom) {
    const qObj = findQuestionById(qId);
    const dropdownVal = selectElem.value;
    const currentVal = answerStore[qId] ? answerStore[qId].answer_val : '';
    let multiArr = parseMultipleAnswers(currentVal, 'dropdown', hasCustom);

    // Duplicate Check: ensure no other row in this question already selected this value
    if (dropdownVal && dropdownVal.trim() !== '') {
      const isDuplicate = multiArr.some((item, idx) => {
        if (idx === rIdx) return false;
        const itemVal = typeof item === 'object' && item !== null ? (item.dropdown || '') : String(item || '');
        return itemVal.toLowerCase() === dropdownVal.toLowerCase();
      });

      if (isDuplicate) {
        showToastNotification(`"${dropdownVal}" is already selected in another row. Duplicate options are not allowed.`, 'warning');
        selectElem.value = '';
        if (hasCustom) {
          multiArr[rIdx] = { dropdown: '', custom: (multiArr[rIdx] && typeof multiArr[rIdx] === 'object' ? multiArr[rIdx].custom : '') };
        } else {
          multiArr[rIdx] = '';
        }
        handleInputChange(qId, JSON.stringify(multiArr));
        refreshMultiDropdownOptions(qId);
        return;
      }
    }

    while (multiArr.length <= rIdx) {
      multiArr.push(hasCustom ? { dropdown: '', custom: '' } : '');
    }

    if (hasCustom) {
      const prevCustom = (multiArr[rIdx] && typeof multiArr[rIdx] === 'object') ? (multiArr[rIdx].custom || '') : '';
      multiArr[rIdx] = { dropdown: dropdownVal, custom: prevCustom };
    } else {
      multiArr[rIdx] = dropdownVal;
    }

    handleInputChange(qId, JSON.stringify(multiArr));
    refreshMultiDropdownOptions(qId);
  }

  function refreshMultiDropdownOptions(qId) {
    const wrap = document.getElementById(`multiAnsWrap_${qId}`);
    if (!wrap) return;
    const selects = wrap.querySelectorAll(`select[data-qid="${qId}"]`);
    if (!selects || selects.length === 0) return;

    // Collect all selected values across the rows
    const rowSelections = [];
    selects.forEach((sel, idx) => {
      rowSelections.push({ idx, val: sel.value || '' });
    });

    selects.forEach((sel, selIdx) => {
      const currentVal = sel.value;
      const otherSelected = rowSelections
        .filter(r => r.idx !== selIdx && r.val !== '')
        .map(r => r.val);

      Array.from(sel.options).forEach(opt => {
        if (!opt.value) return; // Skip placeholder
        const isSelectedElsewhere = otherSelected.includes(opt.value);
        if (isSelectedElsewhere) {
          opt.disabled = true;
          opt.style.color = '#94a3b8';
          opt.style.backgroundColor = '#f1f5f9';
          if (!opt.text.includes('(Already Selected)')) {
            opt.setAttribute('data-base-text', opt.getAttribute('data-base-text') || opt.text);
            opt.text = `${opt.getAttribute('data-base-text')} (Already Selected)`;
          }
        } else {
          opt.disabled = false;
          opt.style.color = '';
          opt.style.backgroundColor = '';
          const baseText = opt.getAttribute('data-base-text');
          if (baseText) {
            opt.text = baseText;
            opt.removeAttribute('data-base-text');
          }
        }
      });
    });
  }

  function showToastNotification(message, type = 'info') {
    let container = document.getElementById('vsmeToastContainer');
    if (!container) {
      container = document.createElement('div');
      container.id = 'vsmeToastContainer';
      container.style.cssText = 'position: fixed; top: 24px; right: 24px; z-index: 9999; display: flex; flex-direction: column; gap: 10px; pointer-events: none;';
      document.body.appendChild(container);
    }

    const toast = document.createElement('div');
    const bgClass = type === 'warning' ? 'bg-warning text-dark' : (type === 'danger' ? 'bg-danger text-white' : 'bg-primary text-white');
    const iconClass = type === 'warning' ? 'icofont-warning' : (type === 'danger' ? 'icofont-close-circled' : 'icofont-info-circle');

    toast.className = `p-3 rounded-3 shadow-lg d-flex align-items-center gap-2 ${bgClass}`;
    toast.style.cssText = 'min-width: 300px; max-width: 440px; pointer-events: auto; animation: slideInRight 0.3s ease; font-size: 0.88rem; font-weight: 600;';
    toast.innerHTML = `
      <i class="icofont ${iconClass} fs-5"></i>
      <span class="flex-grow-1">${escapeHtml(message)}</span>
      <button type="button" class="btn-close ${type !== 'warning' ? 'btn-close-white' : ''} btn-sm ms-2" onclick="this.parentElement.remove()"></button>
    `;

    container.appendChild(toast);

    setTimeout(() => {
      if (toast && toast.parentElement) {
        toast.style.animation = 'fadeOut 0.4s ease';
        setTimeout(() => toast.remove(), 400);
      }
    }, 3500);
  }

