<!-- Client Questionnaire Engine Script -->
<script>
  // Server injected data
  const rawTemplate = <%- JSON.stringify(formData.template) %>;
  const rawAnswers = <%- JSON.stringify(formData.answers || {}) %>;
  const rawClassified = <%- JSON.stringify(formData.classifiedSections || {}) %>;
  const dropdownMasterMap = <%- JSON.stringify(formData.dropdownMaster || {}) %>;
  const projectId = <%= project_id || 0 %>;
  let currentLanguage = '<%= selected_language || "en" %>';

  // Client State
  let activeCatIndex = 0;
  let activeLabelIndex = 0;
  let activeQuestionIndex = 0;
  const answerStore = { ...rawAnswers };
  const classifiedStore = { ...rawClassified };
  let isDirty = false;
  let autoSaveTimer = null;
  let idleTimer = null;

  // Flattened slide index map for smooth carousel
  let activeCategory = null;
  let activeLabel = null;

  // DOM Elements
  const slideContentArea = document.getElementById('slideContentArea');
  const labelTreeList = document.getElementById('labelTreeList');
  const treeCategoryName = document.getElementById('treeCategoryName');
  const slideCounterText = document.getElementById('slideCounterText');
  const autoSaveBadge = document.getElementById('autoSaveBadge');
  const autoSaveText = document.getElementById('autoSaveText');
  const progressBarFill = document.getElementById('progressBarFill');
  const progressStatsText = document.getElementById('progressStatsText');

  // Initialization
  document.addEventListener('DOMContentLoaded', () => {
    initReportingContext();
    initCategoryTabs();
    renderActiveSlide();
    updateOverallProgress();
    setupEventListeners();
    setupIdleDetection();
    initStickyStepper();
  });

  // Dynamic Reporting Context (Dates & Currency) Engine
  let globalReportingFromDate = '';
  let globalReportingToDate = '';
  let globalReportingCurrency = '';

  function initReportingContext() {
    // 1. Check if dates or currency are already present in answerStore
    for (let qId in answerStore) {
      const q = findQuestionById(parseInt(qId, 10));
      if (!q) continue;
      const a = answerStore[qId];
      if (!a || a.answer_val === undefined || a.answer_val === null) continue;
      const val = String(a.answer_val).trim();
      if (!val) continue;

      const qEn = (q.question_en || '').toLowerCase();
      if (!globalReportingFromDate && (qEn.includes('reporting period start') || qEn.includes('start date') || q.id === 396)) {
        globalReportingFromDate = val;
      }
      if (!globalReportingToDate && (qEn.includes('reporting period end') || qEn.includes('end date') || q.id === 397)) {
        globalReportingToDate = val;
      }
      if (!globalReportingCurrency && (q.dropdown_group_name === 'currency' || qEn.includes('currency of the monetary') || q.id === 395)) {
        globalReportingCurrency = val;
      }
    }

    // 2. Populate top toolbar currency dropdown
    const topCurrSel = document.getElementById('topCurrencySelect');
    if (topCurrSel && dropdownMasterMap && dropdownMasterMap['currency']) {
      const currOpts = dropdownMasterMap['currency'] || [];
      topCurrSel.innerHTML = '<option value="">-- Currency --</option>' + currOpts.map(opt => `
        <option value="${escapeHtml(opt.value_en)}" ${globalReportingCurrency === opt.value_en ? 'selected' : ''}>
          ${escapeHtml(opt.value_en)}
        </option>
      `).join('');
    }

    // 3. Populate top toolbar date inputs
    const topFrom = document.getElementById('topFromDate');
    const topTo = document.getElementById('topToDate');
    if (topFrom && globalReportingFromDate) topFrom.value = globalReportingFromDate;
    if (topTo && globalReportingToDate) topTo.value = globalReportingToDate;
  }

  function getActivePeriodAndCurrency() {
    return {
      fromDate: globalReportingFromDate || '',
      toDate: globalReportingToDate || '',
      currency: globalReportingCurrency || ''
    };
  }

  function formatDynamicText(text) {
    if (!text || typeof text !== 'string') return text || '';
    const { fromDate, toDate, currency } = getActivePeriodAndCurrency();

    let formatted = text;

    // 1. Explicit indicators: {FROM DATE}, {TO DATE}, {CURRENCY}
    if (fromDate) {
      formatted = formatted.replace(/\{(from\s*date|from_date|start_date|start\s*date)\}/gi, fromDate);
    }
    if (toDate) {
      formatted = formatted.replace(/\{(to\s*date|to_date|end_date|end\s*date)\}/gi, toDate);
    }
    if (currency) {
      formatted = formatted.replace(/\{(currency|currency_code|curr)\}/gi, currency);
    }

    // 2. Existing template date pattern: "from - to -"
    if (fromDate || toDate) {
      const fromStr = fromDate || '-';
      const toStr = toDate || '-';
      formatted = formatted.replace(/\bfrom\s*-\s*to\s*-(?!\w)/gi, `from ${fromStr} to ${toStr}`);
    }

    // 3. Currency pattern replacement: "in AMD" / "in USD" / "in EUR" -> "in [CURRENCY]"
    if (currency) {
      formatted = formatted.replace(/\bin\s+(AMD|EUR|USD|GBP|CAD|CHF|AUD|JPY)\b/g, `in ${currency}`);
    }

    return formatted;
  }

  function handleGlobalFromDateChange(val) {
    globalReportingFromDate = val ? String(val).trim() : '';
    syncReportingQuestionAnswer('start_date', globalReportingFromDate);
    refreshAllDynamicLabels();
  }

  function handleGlobalToDateChange(val) {
    globalReportingToDate = val ? String(val).trim() : '';
    syncReportingQuestionAnswer('end_date', globalReportingToDate);
    refreshAllDynamicLabels();
  }

  function handleGlobalCurrencyChange(val) {
    globalReportingCurrency = val ? String(val).trim() : '';
    syncReportingQuestionAnswer('currency', globalReportingCurrency);
    refreshAllDynamicLabels();
  }

  function syncReportingQuestionAnswer(type, val) {
    for (let c of (rawTemplate.categories || [])) {
      for (let l of (c.labels || [])) {
        for (let q of (l.questions || [])) {
          const qEn = (q.question_en || '').toLowerCase();
          let match = false;
          if (type === 'start_date' && (q.id === 396 || qEn.includes('reporting period start') || qEn.includes('start date'))) match = true;
          if (type === 'end_date' && (q.id === 397 || qEn.includes('reporting period end') || qEn.includes('end date'))) match = true;
          if (type === 'currency' && (q.id === 395 || q.dropdown_group_name === 'currency' || qEn.includes('currency of the monetary'))) match = true;

          if (match) {
            answerStore[q.id] = {
              ...answerStore[q.id],
              question_id: q.id,
              excel_cell_ref: q.excel_cell_ref || '',
              answer_val: val,
              category_id: c.id,
              label_id: l.id,
              sheet_name: c.sheet_name || ''
            };
            markDirty();
          }
        }
      }
    }
  }

  function refreshAllDynamicLabels() {
    // 1. Re-render category tabs titles
    (rawTemplate.categories || []).forEach(cat => {
      const catBtn = document.querySelector(`.vsme-cat-tab-btn[data-cat-id="${cat.id}"] .cat-tab-title`);
      if (catBtn) {
        catBtn.innerText = getLocalized(cat.name_translations, cat.name_en || '');
      }
    });

    // 2. Re-render horizontal stepper ribbon
    renderHorizontalStepper();

    // 3. Re-render slide stage (current question & headers)
    renderSlideStage();

    // 4. Update overall progress & nav buttons
    updateOverallProgress();
    updateNavButtons();
  }

  function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function getLocalized(obj, fallback = '') {
    if (!obj) return formatDynamicText(fallback);
    if (typeof obj === 'string') return formatDynamicText(obj);
    const raw = obj[currentLanguage] || obj['en'] || fallback;
    return formatDynamicText(raw);
  }

  function isMultipleAllowed(q) {
    if (!q) return false;
    return q.allow_multiple === 1 || q.allow_multiple === true || q.allow_multiple === '1' || q.allow_multiple === 'true';
  }

  function parseMultipleAnswers(rawVal, inputType, hasValueInput) {
    if (rawVal === undefined || rawVal === null || rawVal === '') {
      if (inputType === 'dropdown' && hasValueInput) {
        return [{ dropdown: '', custom: '' }];
      }
      return [''];
    }
    let arr = [];
    if (Array.isArray(rawVal)) {
      arr = rawVal;
    } else if (typeof rawVal === 'object') {
      arr = [rawVal];
    } else if (typeof rawVal === 'string') {
      try {
        const parsed = JSON.parse(rawVal);
        if (Array.isArray(parsed)) {
          arr = parsed;
        } else if (typeof parsed === 'object' && parsed !== null) {
          arr = [parsed];
        } else {
          arr = [parsed];
        }
      } catch (e) {
        if (inputType === 'dropdown' && hasValueInput) {
          arr = [{ dropdown: rawVal, custom: '' }];
        } else {
          arr = [rawVal];
        }
      }
    } else {
      arr = [rawVal];
    }

    if (arr.length === 0) {
      if (inputType === 'dropdown' && hasValueInput) {
        return [{ dropdown: '', custom: '' }];
      }
      return [''];
    }

    return arr.map(item => {
      if (inputType === 'dropdown' && hasValueInput) {
        if (typeof item === 'object' && item !== null) {
          return {
            dropdown: item.dropdown !== undefined && item.dropdown !== null ? String(item.dropdown) : '',
            custom: item.custom !== undefined && item.custom !== null ? String(item.custom) : ''
          };
        }
        return { dropdown: String(item || ''), custom: '' };
      }
      if (typeof item === 'object' && item !== null) {
        return item.dropdown !== undefined ? String(item.dropdown) : (item.val !== undefined ? String(item.val) : JSON.stringify(item));
      }
      return item !== undefined && item !== null ? String(item) : '';
    });
  }

  function isValidHttpUrl(string) {
    if (!string || typeof string !== 'string') return false;
    const str = string.trim();
    if (!str) return false;
    // Strict URL structure: protocol http/https, domain with valid TLD or localhost/IP
    const urlPattern = /^(https?:\/\/)?((([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,})|localhost|(\d{1,3}\.){3}\d{1,3})(:\d+)?(\/[^\s]*)?$/i;
    return urlPattern.test(str);
  }

  function normalizeUrlString(val) {
    if (!val || typeof val !== 'string') return '';
    let str = val.trim();
    if (!str) return '';
    if (/^https?:\/\//i.test(str)) {
      return str;
    }
    if (/^www\./i.test(str) || /^(([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,})/i.test(str)) {
      return 'https://' + str;
    }
    return str;
  }

  function isQuestionFilled(q) {
    if (!q) return false;
    const a = answerStore[q.id];
    if (!a || a.answer_val === undefined || a.answer_val === null) return false;

    if (isMultipleAllowed(q) && q.input_type !== 'table') {
      const multiArr = parseMultipleAnswers(a.answer_val, q.input_type, q.has_value_input);
      if (q.input_type === 'url') {
        const validUrls = multiArr.filter(item => {
          if (!item) return false;
          const s = String(item).trim();
          return s !== '' && isValidHttpUrl(s);
        });
        return validUrls.length > 0;
      }
      return multiArr.some(item => {
        if (item === null || item === undefined) return false;
        if (typeof item === 'object') {
          return (item.dropdown && String(item.dropdown).trim() !== '') || (item.custom && String(item.custom).trim() !== '');
        }
        return String(item).trim() !== '';
      });
    }

    if (q.input_type === 'url') {
      const valStr = String(a.answer_val).trim();
      return valStr !== '' && isValidHttpUrl(valStr);
    }

    if (q.input_type === 'table') {
      try {
        const rows = typeof a.answer_val === 'string' ? JSON.parse(a.answer_val) : a.answer_val;
        if (Array.isArray(rows)) {
          return rows.some(r => Object.values(r).some(v => v !== undefined && v !== null && String(v).trim() !== ''));
        }
      } catch (e) {}
    }

    return String(a.answer_val).trim() !== '';
  }

  function initCategoryTabs() {
    const catBtns = document.querySelectorAll('.vsme-cat-tab-btn');
    catBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        catBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeCatIndex = parseInt(btn.getAttribute('data-cat-idx'), 10);
        activeLabelIndex = 0;
        activeQuestionIndex = 0;
        renderActiveSlide();
      });
    });
  }

  function renderActiveSlide() {
    if (!rawTemplate.categories || rawTemplate.categories.length === 0) return;

    activeCategory = rawTemplate.categories[activeCatIndex];
    if (!activeCategory || !activeCategory.labels || activeCategory.labels.length === 0) {
      slideContentArea.innerHTML = '<div class="alert alert-info">No labels or questions configured in this category.</div>';
      return;
    }

    if (activeLabelIndex >= activeCategory.labels.length) {
      activeLabelIndex = 0;
    }
    activeLabel = activeCategory.labels[activeLabelIndex];

    // 1. Update Horizontal Stepper on Top
    renderHorizontalStepper();

    // 2. Render Questions in Center PPT Slide
    renderSlideStage();

    // 3. Update Slide Navigation Buttons
    updateNavButtons();
  }

  function renderHorizontalStepper() {
    const treeCategoryName = document.getElementById('treeCategoryName');
    if (treeCategoryName) {
      treeCategoryName.innerText = getLocalized(activeCategory.name_translations, activeCategory.name_en || 'Category');
    }
    const track = document.getElementById('horizontalStepperTrack');
    if (!track) return;
    track.innerHTML = '';

    const labels = activeCategory.labels || [];
    const statsEl = document.getElementById('hStepperStats');
    if (statsEl) {
      statsEl.innerText = `Section ${activeLabelIndex + 1} of ${labels.length}`;
    }

    labels.forEach((lbl, idx) => {
      const isCompleted = checkLabelCompleted(lbl);
      const isActive = idx === activeLabelIndex;
      const qCount = (lbl.questions || []).length;
      const lblName = getLocalized(lbl.name_translations, lbl.name_en || 'Label ' + (idx + 1));

      const isQ1No = isFirstQuestionNo(lbl);

      const item = document.createElement('div');
      item.className = `vsme-h-step-item ${isActive ? 'active' : ''} ${isCompleted ? 'completed' : ''}`;
      item.id = `hStepItem_${idx}`;
      item.innerHTML = `
        <span class="vsme-h-step-num">
          ${isCompleted ? '<i class="icofont icofont-check"></i>' : (idx + 1)}
        </span>
        <span class="vsme-h-step-title" title="${escapeHtml(lblName)}">${escapeHtml(lblName)}</span>
        <span class="vsme-h-step-badge">${isQ1No && qCount > 1 ? 'Q1 (No - Skipped)' : `${qCount} Qs`}</span>
      `;
      item.addEventListener('click', () => {
        activeLabelIndex = idx;
        activeQuestionIndex = 0;
        renderActiveSlide();
      });
      track.appendChild(item);
    });

    // Auto-scroll active item into view
    setTimeout(() => {
      const activeEl = document.getElementById(`hStepItem_${activeLabelIndex}`);
      if (activeEl && track) {
        const leftPos = activeEl.offsetLeft - track.offsetLeft - (track.clientWidth / 2) + (activeEl.clientWidth / 2);
        track.scrollTo({ left: Math.max(0, leftPos), behavior: 'smooth' });
      }
      updateStripNavArrows();
    }, 60);
  }

  function updateStripNavArrows() {
    const track = document.getElementById('horizontalStepperTrack');
    const btnLeft = document.getElementById('btnStripScrollLeft');
    const btnRight = document.getElementById('btnStripScrollRight');
    if (!track || !btnLeft || !btnRight) return;

    btnLeft.disabled = track.scrollLeft <= 5;
    btnRight.disabled = (track.scrollLeft + track.clientWidth) >= (track.scrollWidth - 5);
  }

  function isFirstQuestionNo(lbl) {
    return false;
  }

  function isQuestionHiddenByCondition(q) {
    if (!q || !q.visibility_condition || !q.visibility_condition.depends_on_cell) {
      return false;
    }
    const triggerQ = findQuestionByCell(q.visibility_condition.depends_on_cell);
    if (!triggerQ) return false;

    const rawTrigger = answerStore[triggerQ.id] ? answerStore[triggerQ.id].answer_val : '';

    if (rawTrigger === undefined || rawTrigger === null || String(rawTrigger).trim() === '') {
      return q.visibility_condition.action === 'show';
    }

    let triggerVals = [String(rawTrigger || '')];
    if (typeof rawTrigger === 'string' && rawTrigger.startsWith('[')) {
      try {
        const parsed = JSON.parse(rawTrigger);
        if (Array.isArray(parsed)) {
          triggerVals = parsed.map(it => typeof it === 'object' && it ? (it.dropdown || it.val || '') : String(it));
        }
      } catch (e) {}
    }

    const targetVal = String(q.visibility_condition.value || q.visibility_condition.target_value || '').toLowerCase();
    const op = q.visibility_condition.operator || 'equals';
    let matches = false;

    if (op === 'equals') {
      matches = triggerVals.some(v => v.toLowerCase() === targetVal);
    } else if (op === 'not_equals') {
      matches = triggerVals.every(v => v.toLowerCase() !== targetVal);
    } else if (op === 'is_true') {
      matches = triggerVals.some(v => v === 'TRUE' || v === '1' || v.toLowerCase() === 'yes' || v.toLowerCase() === 'true');
    } else if (op === 'is_false') {
      matches = triggerVals.some(v => v === 'FALSE' || v === '0' || v.toLowerCase() === 'no' || v.toLowerCase() === 'false');
    } else if (op === 'gt') {
      matches = triggerVals.some(v => parseFloat(v) > parseFloat(targetVal));
    } else if (op === 'lt') {
      matches = triggerVals.some(v => parseFloat(v) < parseFloat(targetVal));
    }

    if (q.visibility_condition.action === 'show') {
      return !matches;
    } else {
      return matches;
    }
  }

  function isOtherSpecificationQuestion(q, lbl) {
    if (!q || !lbl || !lbl.questions || lbl.questions.length <= 1) return false;
    const qIdx = lbl.questions.findIndex(item => item.id === q.id);
    if (qIdx <= 0) return false;
    const prevQ = lbl.questions[qIdx - 1];

    let prevHasOtherOption = false;
    if (prevQ && prevQ.input_type === 'dropdown' && prevQ.dropdown_group_name) {
      const options = dropdownMasterMap[prevQ.dropdown_group_name] || [];
      prevHasOtherOption = options.some(opt => (opt.value_en && opt.value_en.toLowerCase().includes('other')));
    }

    const qEn = (q.question_en || '').toLowerCase();
    const isOtherText = qEn.includes('other') && (qEn.includes('specification') || qEn.includes('specify') || qEn.includes('legal form'));

    return prevHasOtherOption || isOtherText;
  }

  function isParentAnsweredOther(q, lbl) {
    if (!isOtherSpecificationQuestion(q, lbl)) return true;
    const qIdx = lbl.questions.findIndex(item => item.id === q.id);
    if (qIdx <= 0) return true;
    const prevQ = lbl.questions[qIdx - 1];
    if (!prevQ) return true;
    const a = answerStore[prevQ.id];
    if (!a || a.answer_val === undefined || a.answer_val === null) return false;

    let valStr = '';
    if (typeof a.answer_val === 'string' && a.answer_val.startsWith('[')) {
      try {
        const parsed = JSON.parse(a.answer_val);
        if (Array.isArray(parsed)) {
          return parsed.some(it => {
            const s = typeof it === 'object' && it ? (it.dropdown || it.val || '') : String(it);
            return s.toLowerCase().includes('other');
          });
        }
      } catch (e) {}
    } else if (typeof a.answer_val === 'object') {
      valStr = String(a.answer_val.dropdown || a.answer_val.val || '');
    } else {
      valStr = String(a.answer_val);
    }
    return valStr.toLowerCase().includes('other');
  }

  function getQuestionDisplayInfo(q, lbl) {
    if (!lbl || !lbl.questions || !q) return { numStr: '1', pillStr: 'Q1', isChild: false, parentNumStr: '', parentQIdx: -1 };
    const targetIdx = lbl.questions.findIndex(item => item.id === q.id);
    if (targetIdx === -1) return { numStr: '1', pillStr: 'Q1', isChild: false, parentNumStr: '', parentQIdx: -1 };

    let parentCounter = 0;
    let targetInfo = { numStr: String(targetIdx + 1), pillStr: `Q${targetIdx + 1}`, isChild: false, parentNumStr: '', parentQIdx: -1 };

    for (let i = 0; i < lbl.questions.length; i++) {
      const curQ = lbl.questions[i];
      const isChild = Boolean(curQ && curQ.visibility_condition && curQ.visibility_condition.depends_on_cell);

      if (isChild) {
        const parentNum = parentCounter > 0 ? parentCounter : 1;
        const numStr = `${parentNum}.1`;
        const pillStr = `Q${parentNum}.1`;
        if (i === targetIdx) {
          targetInfo = { numStr, pillStr, isChild: true, parentNumStr: String(parentNum), parentQIdx: i - 1 };
          break;
        }
      } else {
        parentCounter++;
        const numStr = String(parentCounter);
        const pillStr = `Q${parentCounter}`;
        if (i === targetIdx) {
          targetInfo = { numStr, pillStr, isChild: false, parentNumStr: '', parentQIdx: -1 };
          break;
        }
      }
    }
    return targetInfo;
  }

  function isQuestionSkipped(q, lbl) {
    if (!q) return false;

    // Rely strictly on dynamic visibility condition set by admin in Template Builder (Show/Hide Logic)
    return isQuestionHiddenByCondition(q);
  }

  function checkLabelCompleted(lbl) {
    if (!lbl) return true;
    if (classifiedStore[lbl.id]) return true;
    if (!lbl.questions || lbl.questions.length === 0) return true;
    return lbl.questions.every(q => isQuestionFilled(q) || isQuestionSkipped(q, lbl));
  }

  function renderSlideStage() {
    const catTitle = getLocalized(activeCategory.name_translations, activeCategory.name_en || '');
    const lblTitle = getLocalized(activeLabel.name_translations, activeLabel.name_en || '');
    const isOmittable = activeLabel.is_omittable || activeCategory.is_omittable;
    const isClassified = classifiedStore[activeLabel.id] ? true : false;
    const questions = activeLabel.questions || [];
    const totalQ = questions.length;

    if (activeQuestionIndex >= totalQ && totalQ > 0) {
      activeQuestionIndex = 0;
    }

    let html = `
      <div class="vsme-slide-header">
        <div>
          <span class="vsme-slide-tag">${catTitle}</span>
          <h3 class="vsme-slide-title">${lblTitle}</h3>
        </div>
        <div class="d-flex align-items-center gap-3">
          ${isOmittable ? `
            <div class="form-check form-switch d-flex align-items-center gap-2">
              <input class="form-check-input" type="checkbox" id="omissionToggle_${activeLabel.id}" ${isClassified ? 'checked' : ''} onchange="toggleOmissionSection(${activeLabel.id})">
              <label class="form-check-label small fw-bold text-muted" for="omissionToggle_${activeLabel.id}">Mark as Confidential / Omitted</label>
            </div>
          ` : ''}
          ${activeLabel.info_translations ? `
            <button type="button" class="btn btn-outline-primary btn-sm" onclick="showGuidanceDrawer('label', ${activeLabel.id})">
              <i class="icofont icofont-info-circle me-1"></i> Section Guidance
            </button>
          ` : ''}
        </div>
      </div>
    `;

    if (totalQ === 0) {
      html += '<div class="alert alert-secondary py-4 text-center">No questions defined under this section.</div>';
    } else {
      let currentQ = questions[activeQuestionIndex];
      let isCurrentFilled = isQuestionFilled(currentQ);
      let isCurrentSkipped = isQuestionSkipped(currentQ, activeLabel);
      let isQ1No = isFirstQuestionNo(activeLabel);
      let answeredInLbl = isQ1No ? totalQ : questions.filter(q => isQuestionFilled(q) || isQuestionSkipped(q, activeLabel)).length;
      let currentDisp = getQuestionDisplayInfo(currentQ, activeLabel);

      html += `
        <!-- Question Step Progress Tracker Bar -->
        <div class="vsme-question-tracker-bar">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="d-flex align-items-center gap-2">
              <span class="badge ${currentDisp.isChild ? 'bg-purple text-white' : 'bg-primary'} px-3 py-1.5" style="border-radius: 8px;">
                ${currentDisp.isChild ? `<i class="icofont icofont-sub-listing me-1"></i>Question ${currentDisp.numStr}` : `Question ${currentDisp.numStr}`} of ${totalQ}
              </span>
              <span class="small fw-bold text-muted">(${answeredInLbl}/${totalQ} ${isQ1No ? 'Resolved' : 'Answered'})</span>
            </div>
            <div>
              ${isCurrentSkipped ?
                '<span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1"><i class="icofont icofont-ban me-1"></i> Skipped</span>' :
                (isCurrentFilled ? 
                  '<span class="badge bg-success-subtle text-success border border-success px-2 py-1"><i class="icofont icofont-check-circled me-1"></i> Answered</span>' : 
                  '<span class="badge bg-light text-secondary border px-2 py-1">In Progress</span>'
                )
              }
            </div>
          </div>
          <div class="vsme-q-step-pills">
            ${questions.map((q, idx) => {
              const filled = isQuestionFilled(q);
              const isSkipped = isQuestionSkipped(q, activeLabel);
              const isActive = idx === activeQuestionIndex;
              const disp = getQuestionDisplayInfo(q, activeLabel);

              let pillClass = 'vsme-q-pill-btn';
              if (isActive) pillClass += ' active';
              if (isSkipped) pillClass += ' skipped';
              else if (filled) pillClass += ' filled';
              if (disp.isChild) pillClass += ' vsme-q-pill-child';

              let dotContent = disp.numStr;
              if (isSkipped) dotContent = '<i class="icofont icofont-ban"></i>';
              else if (filled) dotContent = '<i class="icofont icofont-check"></i>';

              let pillTitle = `Question ${disp.numStr}`;
              if (disp.isChild) pillTitle += ` (Follow-up to Q${disp.parentNumStr})`;
              if (isSkipped) pillTitle += ' (Skipped)';

              return `
                <button type="button" class="${pillClass}" onclick="jumpToQuestion(${idx})" title="${escapeHtml(pillTitle)}">
                  <span class="vsme-q-pill-dot">${dotContent}</span>
                  <span>${disp.pillStr}${isSkipped ? ' <small style="opacity: 0.8;">(Skipped)</small>' : ''}</span>
                </button>
              `;
            }).join('')}
          </div>
        </div>

        <div id="questionsContainer" style="${isClassified ? 'opacity: 0.45; pointer-events: none;' : ''}">
          ${renderQuestionCard(currentQ, activeQuestionIndex)}
        </div>
      `;
    }

    slideContentArea.innerHTML = html;

    // Trigger calculation updates and visibility evaluation
    evaluateFormulas();
    evaluateVisibility();
  }

  function renderQuestionCard(q, qIdx) {
    const qText = getLocalized(q.question_translations, q.question_en || '');
    const currentAnsObj = answerStore[q.id] || {};
    let val = currentAnsObj.answer_val !== undefined && currentAnsObj.answer_val !== null ? currentAnsObj.answer_val : '';
    const allowMultiple = isMultipleAllowed(q) && q.input_type !== 'table' && q.input_type !== 'calculated';
    const isSkipped = isQuestionSkipped(q, activeLabel);
    const disp = getQuestionDisplayInfo(q, activeLabel);

    const copyCfg = q.copy_config || (q.formula_config ? q.formula_config.copy_config : null);
    const isCopyReadOnly = copyCfg && copyCfg.parent_cell_ref && copyCfg.access_mode === 'readonly';
    const isCopyEditable = copyCfg && copyCfg.parent_cell_ref && copyCfg.access_mode === 'editable';

    const qInfoText = q.info_translations ? getLocalized(q.info_translations, '') : '';
    const hasInfo = qInfoText && qInfoText.trim().length > 0;

    let inputHtml = '';
    if (allowMultiple) {
      inputHtml = renderMultipleAnswersInput(q, val);
    } else {
      inputHtml = renderSingleAnswerInput(q, val);
    }

    return `
      <div class="vsme-q-card ${isSkipped ? 'vsme-q-card-skipped' : ''}" id="qCard_${q.id}" data-qid="${q.id}">
        <div class="alert alert-warning d-flex align-items-center justify-content-between p-3 mb-3 border-0 shadow-sm vsme-skip-banner ${isSkipped ? '' : 'd-none'}" id="skipBanner_${q.id}" style="border-radius: 12px; background: #fffbeb; border-left: 4px solid #f59e0b !important;">
          <div class="d-flex align-items-center gap-2">
            <i class="icofont icofont-ban text-warning fs-4"></i>
            <div>
              <strong class="text-dark d-block">Question Skipped / Disabled (Non-Entry)</strong>
              <small class="text-muted" id="skipText_${q.id}">
                ${q.visibility_condition && q.visibility_condition.depends_on_cell ?
                  `This question is skipped based on condition set on cell <strong>${escapeHtml(q.visibility_condition.depends_on_cell)}</strong>.` :
                  (disp.isChild ? `This follow-up question is only required if you select <strong>"Other (please specify...)"</strong> in Question ${disp.parentNumStr}.` : 'This question is currently disabled based on trigger condition.')
                }
              </small>
            </div>
          </div>
        </div>
        <div class="vsme-q-header">
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge ${disp.isChild ? 'bg-purple text-white' : 'bg-light text-dark border'}">${disp.numStr}</span>
            <h6 class="vsme-q-label mb-0">${escapeHtml(qText)}</h6>
            ${disp.isChild ? `
              <span class="badge bg-purple-subtle text-purple border border-purple-subtle px-2 py-1 small">
                <i class="icofont icofont-sub-listing me-1"></i>Follow-up to Q${disp.parentNumStr}
              </span>
            ` : ''}
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1 small vsme-skip-badge ${isSkipped ? '' : 'd-none'}" id="skipBadge_${q.id}">
              <i class="icofont icofont-ban me-1"></i>Skipped (Disabled)
            </span>
            ${allowMultiple ? `
              <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 small vsme-multi-badge ${isSkipped ? 'd-none' : ''}" id="multiBadge_${q.id}">
                <i class="icofont icofont-plus-circle me-1"></i>Multiple Answers
              </span>
            ` : ''}
          </div>
          <div class="d-flex align-items-center gap-2">
            ${q.info_translations ? `
              <button type="button" class="vsme-q-info-btn" title="View guidance" onclick="showGuidanceDrawer('question', ${q.id})">
                <i class="icofont icofont-info"></i>
              </button>
            ` : ''}
          </div>
        </div>
        <div class="vsme-q-body" id="qBody_${q.id}" style="${isSkipped ? 'opacity: 0.45; pointer-events: none;' : ''}">
          ${inputHtml}
          ${isCopyReadOnly ? `
            <small class="text-primary fw-bold mt-1.5 d-block" style="font-size: 0.78rem;">
              <i class="icofont icofont-lock me-1"></i>Auto-copied from Parent Cell <code>${escapeHtml(copyCfg.parent_cell_ref)}</code> (Non-Entry / Read-only)
            </small>
          ` : ''}
          ${isCopyEditable ? `
            <small class="text-info fw-bold mt-1.5 d-block" style="font-size: 0.78rem;">
              <i class="icofont icofont-link me-1"></i>Auto-prefilled from Parent Cell <code>${escapeHtml(copyCfg.parent_cell_ref)}</code> (Editable / Entry)
            </small>
          ` : ''}
        </div>
      </div>
    `;
  }

  function renderSingleAnswerInput(q, val) {
    if (q.input_type === 'boolean') {
      const isYes = val === 'true' || val === '1' || val === 'Yes' || val === 'TRUE';
      const isNo = val === 'false' || val === '0' || val === 'No' || val === 'FALSE';
      return `
        <div class="vsme-segmented-bool" data-qid="${q.id}">
          <button type="button" class="vsme-seg-btn ${isYes ? 'active-yes' : ''}" onclick="setBoolAnswer(${q.id}, 'TRUE', this)">Yes</button>
          <button type="button" class="vsme-seg-btn ${isNo ? 'active-no' : ''}" onclick="setBoolAnswer(${q.id}, 'FALSE', this)">No</button>
          <button type="button" class="vsme-seg-btn ${val === 'N/A' ? 'active-no' : ''}" onclick="setBoolAnswer(${q.id}, 'N/A', this)">N/A</button>
        </div>
      `;
    } else if (q.input_type === 'dropdown') {
      const options = dropdownMasterMap[q.dropdown_group_name] || [];
      let customVal = '';
      let selectedOption = val;

      if (q.has_value_input) {
        try {
          const parsed = typeof val === 'string' ? JSON.parse(val) : val;
          if (parsed && typeof parsed === 'object') {
            selectedOption = parsed.dropdown || '';
            customVal = parsed.custom || '';
          }
        } catch (e) {
          selectedOption = val;
        }
      }

      return `
        <div class="row g-2">
          <div class="${q.has_value_input ? 'col-md-6' : 'col-12'}">
            <select class="form-select vsme-input-control" data-qid="${q.id}" onchange="handleDropdownChange(${q.id}, this, ${q.has_value_input ? 'true' : 'false'})">
              <option value="">-- Select Option --</option>
              ${options.map(opt => `
                <option value="${escapeHtml(opt.value_en)}" ${selectedOption === opt.value_en ? 'selected' : ''}>
                  ${escapeHtml(currentLanguage === 'fr' ? (opt.value_fr || opt.value_en) : opt.value_en)}
                </option>
              `).join('')}
            </select>
          </div>
          ${q.has_value_input ? `
            <div class="col-md-6">
              <input type="text" class="form-control vsme-input-control" id="customInput_${q.id}" placeholder="Enter specific value..." value="${escapeHtml(customVal)}" oninput="handleCustomValChange(${q.id}, this)">
            </div>
          ` : ''}
        </div>
      `;
    } else if (q.input_type === 'date') {
      return `
        <div class="input-group">
          <span class="input-group-text bg-light"><i class="icofont icofont-ui-calendar text-primary"></i></span>
          <input type="date" class="form-control vsme-input-control" data-qid="${q.id}" value="${escapeHtml(val)}" onchange="handleInputChange(${q.id}, this.value)">
        </div>
      `;
    } else if (q.input_type === 'calculated') {
      return `
        <div class="vsme-calc-box">
          <span class="vsme-calc-val" id="calcDisplay_${q.id}">0.00</span>
          <span class="vsme-calc-formula"><i class="icofont icofont-calculator-alt me-1"></i> Auto-Calculated</span>
        </div>
      `;
    } else if (q.input_type === 'table') {
      return renderTableQuestion(q, val);
    } else if (q.input_type === 'number') {
      return `
        <input type="number" step="any" class="form-control vsme-input-control" data-qid="${q.id}" placeholder="Enter numeric value..." value="${escapeHtml(val)}" oninput="handleInputChange(${q.id}, this.value)">
      `;
    } else if (q.input_type === 'email') {
      return `
        <input type="email" class="form-control vsme-input-control" data-qid="${q.id}" placeholder="name@domain.com" value="${escapeHtml(val)}" oninput="handleInputChange(${q.id}, this.value)">
      `;
    } else if (q.input_type === 'url') {
      const isUrlValid = val ? isValidHttpUrl(val) : true;
      const hasVal = Boolean(val && String(val).trim() !== '');
      const validityClass = hasVal ? (isUrlValid ? 'is-valid' : 'is-invalid') : '';
      return `
        <div class="vsme-url-input-wrap">
          <div class="input-group">
            <span class="input-group-text bg-light text-primary"><i class="icofont icofont-link"></i></span>
            <input type="url" class="form-control vsme-input-control ${validityClass}" data-qid="${q.id}" placeholder="https://example.com" value="${escapeHtml(val)}" oninput="handleUrlInputChange(${q.id}, this)" onblur="handleUrlBlur(${q.id}, this)">
          </div>
          <div class="invalid-feedback ${hasVal && !isUrlValid ? 'd-block' : 'd-none'} text-danger small mt-1" id="urlErr_${q.id}">
            <i class="icofont icofont-warning-alt me-1"></i> Please enter a valid URL (e.g., https://example.com)
          </div>
          <small class="text-muted d-block mt-1"><i class="icofont icofont-info-circle me-1"></i> Must be a valid web link starting with http:// or https://</small>
        </div>
      `;
    } else {
      return `
        <input type="text" class="form-control vsme-input-control" data-qid="${q.id}" placeholder="Type answer here..." value="${escapeHtml(val)}" oninput="handleInputChange(${q.id}, this.value)">
      `;
    }
  }

  function renderMultipleAnswersInput(q, val) {
    const multiAnswers = parseMultipleAnswers(val, q.input_type, q.has_value_input);
    const options = (q.input_type === 'dropdown' && q.dropdown_group_name) ? (dropdownMasterMap[q.dropdown_group_name] || []) : [];

    let rowsHtml = multiAnswers.map((item, rIdx) => {
      let fieldHtml = '';

      if (q.input_type === 'dropdown') {
        let selectedOption = '';
        let customVal = '';

        if (q.has_value_input) {
          if (typeof item === 'object' && item !== null) {
            selectedOption = item.dropdown || '';
            customVal = item.custom || '';
          } else {
            selectedOption = String(item || '');
          }
        } else {
          selectedOption = typeof item === 'object' && item !== null ? (item.dropdown || '') : String(item || '');
        }

        // Values selected in other rows
        const selectedInOtherRows = multiAnswers
          .filter((_, idx) => idx !== rIdx)
          .map(it => typeof it === 'object' && it !== null ? (it.dropdown || '') : String(it || ''))
          .filter(v => v !== '');

        fieldHtml = `
          <div class="row g-2 flex-grow-1">
            <div class="${q.has_value_input ? 'col-md-6' : 'col-12'}">
              <select class="form-select vsme-input-control" data-qid="${q.id}" data-row-idx="${rIdx}" onchange="handleMultiDropdownChange(${q.id}, ${rIdx}, this, ${q.has_value_input ? 'true' : 'false'})">
                <option value="">-- Select Option --</option>
                ${options.map(opt => {
                  const isSelected = selectedOption === opt.value_en;
                  const isAlreadySelectedElsewhere = !isSelected && selectedInOtherRows.includes(opt.value_en);
                  const optLabel = currentLanguage === 'fr' ? (opt.value_fr || opt.value_en) : opt.value_en;
                  return `
                    <option value="${escapeHtml(opt.value_en)}" ${isSelected ? 'selected' : ''} ${isAlreadySelectedElsewhere ? 'disabled style="color: #94a3b8; background-color: #f1f5f9;"' : ''}>
                      ${escapeHtml(optLabel)}${isAlreadySelectedElsewhere ? ' (Already Selected)' : ''}
                    </option>
                  `;
                }).join('')}
              </select>
            </div>
            ${q.has_value_input ? `
              <div class="col-md-6">
                <input type="text" class="form-control vsme-input-control" placeholder="Enter specific value..." value="${escapeHtml(customVal)}" oninput="handleMultiCustomValChange(${q.id}, ${rIdx}, this)">
              </div>
            ` : ''}
          </div>
        `;
      } else if (q.input_type === 'boolean') {
        const itemStr = String(item || '');
        const isYes = itemStr === 'true' || itemStr === '1' || itemStr === 'Yes' || itemStr === 'TRUE';
        const isNo = itemStr === 'false' || itemStr === '0' || itemStr === 'No' || itemStr === 'FALSE';
        fieldHtml = `
          <div class="vsme-segmented-bool flex-grow-1" data-qid="${q.id}" data-row-idx="${rIdx}">
            <button type="button" class="vsme-seg-btn ${isYes ? 'active-yes' : ''}" onclick="setMultiBoolAnswer(${q.id}, ${rIdx}, 'TRUE', this)">Yes</button>
            <button type="button" class="vsme-seg-btn ${isNo ? 'active-no' : ''}" onclick="setMultiBoolAnswer(${q.id}, ${rIdx}, 'FALSE', this)">No</button>
            <button type="button" class="vsme-seg-btn ${itemStr === 'N/A' ? 'active-no' : ''}" onclick="setMultiBoolAnswer(${q.id}, ${rIdx}, 'N/A', this)">N/A</button>
          </div>
        `;
      } else if (q.input_type === 'date') {
        fieldHtml = `
          <div class="input-group flex-grow-1">
            <span class="input-group-text bg-light"><i class="icofont icofont-ui-calendar text-primary"></i></span>
            <input type="date" class="form-control vsme-input-control" data-qid="${q.id}" data-row-idx="${rIdx}" value="${escapeHtml(item)}" onchange="handleMultiInputChange(${q.id}, ${rIdx}, this.value)">
          </div>
        `;
      } else if (q.input_type === 'number') {
        fieldHtml = `
          <input type="number" step="any" class="form-control vsme-input-control flex-grow-1" data-qid="${q.id}" data-row-idx="${rIdx}" placeholder="Enter numeric value #${rIdx + 1}..." value="${escapeHtml(item)}" oninput="handleMultiInputChange(${q.id}, ${rIdx}, this.value)">
        `;
      } else if (q.input_type === 'email') {
        fieldHtml = `
          <input type="email" class="form-control vsme-input-control flex-grow-1" data-qid="${q.id}" data-row-idx="${rIdx}" placeholder="name@domain.com (Answer #${rIdx + 1})" value="${escapeHtml(item)}" oninput="handleMultiInputChange(${q.id}, ${rIdx}, this.value)">
        `;
      } else if (q.input_type === 'url') {
        const itemStr = String(item || '').trim();
        const isUrlValid = itemStr ? isValidHttpUrl(itemStr) : true;
        const hasVal = Boolean(itemStr !== '');
        const validityClass = hasVal ? (isUrlValid ? 'is-valid' : 'is-invalid') : '';
        fieldHtml = `
          <div class="vsme-url-input-wrap flex-grow-1">
            <div class="input-group">
              <span class="input-group-text bg-light text-primary"><i class="icofont icofont-link"></i></span>
              <input type="url" class="form-control vsme-input-control ${validityClass}" data-qid="${q.id}" data-row-idx="${rIdx}" placeholder="https://example.com (Answer #${rIdx + 1})" value="${escapeHtml(item)}" oninput="handleMultiUrlInputChange(${q.id}, ${rIdx}, this)" onblur="handleMultiUrlBlur(${q.id}, ${rIdx}, this)">
            </div>
            <div class="invalid-feedback ${hasVal && !isUrlValid ? 'd-block' : 'd-none'} text-danger small mt-1" id="urlErr_${q.id}_${rIdx}">
              <i class="icofont icofont-warning-alt me-1"></i> Please enter a valid URL (e.g., https://example.com)
            </div>
          </div>
        `;
      } else {
        fieldHtml = `
          <input type="text" class="form-control vsme-input-control flex-grow-1" data-qid="${q.id}" data-row-idx="${rIdx}" placeholder="Type answer #${rIdx + 1}..." value="${escapeHtml(item)}" oninput="handleMultiInputChange(${q.id}, ${rIdx}, this.value)">
        `;
      }

      return `
        <div class="vsme-multi-ans-row d-flex align-items-center gap-2 mb-2" data-row-idx="${rIdx}">
          <span class="vsme-multi-row-badge">${rIdx + 1}</span>
          ${fieldHtml}
          ${multiAnswers.length > 1 ? `
            <button type="button" class="btn btn-outline-danger btn-sm vsme-multi-del-btn" onclick="removeMultiAnswerRow(${q.id}, ${rIdx})" title="Remove this answer">
              <i class="icofont icofont-trash"></i>
            </button>
          ` : `
            <button type="button" class="btn btn-outline-secondary btn-sm vsme-multi-del-btn disabled" style="opacity: 0.25; cursor: not-allowed;" title="Minimum 1 answer row">
              <i class="icofont icofont-trash"></i>
            </button>
          `}
        </div>
      `;
    }).join('');

    return `
      <div class="vsme-multi-ans-wrap" id="multiAnsWrap_${q.id}">
        <div class="vsme-multi-rows-list" id="multiRowsList_${q.id}">
          ${rowsHtml}
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
          <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 vsme-add-ans-btn" onclick="addMultiAnswerRow(${q.id})">
            <i class="icofont icofont-plus-circle me-1"></i> Add Another Answer (+)
          </button>
          <span class="small text-muted fw-bold" id="multiAnsCount_${q.id}">
            Total: ${multiAnswers.length} ${multiAnswers.length === 1 ? 'Answer' : 'Answers'}
          </span>
        </div>
      </div>
    `;
  }

  function getColumnHeader(c, idx) {
    if (!c) return `Column ${idx + 1}`;
    const titleObj = c.title || c.header_translations || c.header || c.name || c.title_translations;
    const fallback = c.col_name || c.col_id || c.id || `Column ${idx + 1}`;
    return getLocalized(titleObj, fallback);
  }

  function getColumnKey(c, idx) {
    if (!c) return `col_${idx + 1}`;
    return c.col_id || c.id || `col_${idx + 1}`;
  }

  function renderTableQuestion(q, rawTableVal) {
    const config = q.table_config || { columns: [], summary_rows: [], initial_rows: 3, allow_user_add_rows: true };
    let cols = config.columns && config.columns.length > 0 ? config.columns : [
      { col_id: 'col_1', title: { en: 'Name' }, type: 'string' },
      { col_id: 'col_2', title: { en: 'Amount' }, type: 'number' }
    ];

    let rowsData = [];
    try {
      rowsData = typeof rawTableVal === 'string' && rawTableVal ? JSON.parse(rawTableVal) : (Array.isArray(rawTableVal) ? rawTableVal : []);
    } catch (e) {
      rowsData = [];
    }

    const initialRowCount = config.initial_rows && config.initial_rows > 0 ? config.initial_rows : 1;
    if (rowsData.length === 0) {
      for (let r = 0; r < initialRowCount; r++) {
        rowsData.push({});
      }
    }

    const allowAddRows = config.allow_user_add_rows !== false;
    const minTableWidth = Math.max(750, cols.length * 220 + 130);

    let html = `
      <div class="vsme-slide-table-wrap">
        <div class="vsme-table-toolbar">
          <div>
            <i class="icofont icofont-table text-primary me-1"></i>
            <span class="fw-bold text-dark">${cols.length} Columns</span> &bull; 
            <span>${rowsData.length} Rows</span>
          </div>
          ${cols.length >= 3 ? `
            <div>
              <span class="badge bg-light text-secondary border">
                <i class="icofont icofont-scroll-left-right text-primary me-1"></i> Scroll horizontally to view & edit all columns
              </span>
            </div>
          ` : ''}
        </div>
        <table class="table vsme-slide-table align-middle" id="tableGrid_${q.id}" style="min-width: ${minTableWidth}px;">
          <thead>
            <tr>
              <th style="width: 55px; min-width: 55px;" class="text-center vsme-sticky-col">#</th>
              ${cols.map((c, cIdx) => {
                const headerText = getColumnHeader(c, cIdx);
                const colCopyCfg = c.copy_config;
                let copyBadgeHtml = '';
                if (colCopyCfg && colCopyCfg.parent_cell_ref) {
                  const isReadOnly = colCopyCfg.access_mode === 'readonly';
                  const iconClass = isReadOnly ? 'icofont-lock' : 'icofont-link';
                  const titleText = isReadOnly ? `Auto-copied from ${colCopyCfg.parent_cell_ref} (Read-only)` : `Auto-prefilled from ${colCopyCfg.parent_cell_ref} (Editable)`;
                  copyBadgeHtml = `
                    <span class="badge bg-light text-primary border ms-1 fw-normal" style="font-size: 0.65rem;" title="${escapeHtml(titleText)}">
                      <i class="icofont ${iconClass} me-1"></i>${escapeHtml(colCopyCfg.parent_cell_ref)}
                    </span>
                  `;
                }
                let colMinWidth = 220;
                if (c.type === 'number') colMinWidth = 180;
                else if (headerText.length > 25) colMinWidth = Math.min(380, Math.max(260, headerText.length * 7.5));
                return `<th style="min-width: ${colMinWidth}px;">${headerText}${copyBadgeHtml}</th>`;
              }).join('')}
              ${allowAddRows ? `<th style="width: 70px; min-width: 70px;" class="text-center">Action</th>` : ''}
            </tr>
          </thead>
          <tbody id="tableBody_${q.id}">
            ${rowsData.map((row, rIdx) => `
              <tr data-row-idx="${rIdx}">
                <td class="text-center fw-bold text-muted vsme-sticky-col">${rIdx + 1}</td>
                ${cols.map((c, cIdx) => {
                  const colKey = getColumnKey(c, cIdx);
                  const cellVal = row[colKey] !== undefined && row[colKey] !== null ? row[colKey] : '';
                  const isReadOnly = c.copy_config && c.copy_config.parent_cell_ref && c.copy_config.access_mode === 'readonly';
                  if (c.type === 'dropdown') {
                    const options = dropdownMasterMap[c.dropdown_group] || [];
                    return `
                      <td>
                        <select class="form-select table-cell-input ${isReadOnly ? 'bg-light' : ''}" data-col-id="${colKey}" onchange="handleTableInput(${q.id})" ${isReadOnly ? 'disabled' : ''}>
                          <option value="">-- Select --</option>
                          ${options.map(opt => `
                            <option value="${opt.value_en}" ${cellVal === opt.value_en ? 'selected' : ''}>
                              ${currentLanguage === 'fr' ? (opt.value_fr || opt.value_en) : opt.value_en}
                            </option>
                          `).join('')}
                        </select>
                      </td>
                    `;
                  } else if (c.type === 'number') {
                    return `
                      <td>
                        <input type="number" step="any" class="form-control table-cell-input ${isReadOnly ? 'bg-light' : ''}" data-col-id="${colKey}" placeholder="0.00" value="${cellVal}" oninput="handleTableInput(${q.id})" ${isReadOnly ? 'readonly' : ''}>
                      </td>
                    `;
                  } else {
                    return `
                      <td>
                        <input type="text" class="form-control table-cell-input ${isReadOnly ? 'bg-light' : ''}" data-col-id="${colKey}" placeholder="Enter text..." value="${cellVal}" oninput="handleTableInput(${q.id})" ${isReadOnly ? 'readonly' : ''}>
                      </td>
                    `;
                  }
                }).join('')}
                ${allowAddRows ? `
                  <td class="text-center">
                    <button type="button" class="btn btn-outline-danger btn-sm py-1 px-2 rounded-pill" onclick="removeTableRow(${q.id}, ${rIdx})" title="Delete row">
                      <i class="icofont icofont-trash"></i>
                    </button>
                  </td>
                ` : ''}
              </tr>
            `).join('')}
          </tbody>
          ${(config.summary_rows && config.summary_rows.length > 0) ? `
            <tfoot class="table-light border-top-2" id="tableFoot_${q.id}">
              ${config.summary_rows.map((sum, sIdx) => {
                const sumTitle = getLocalized(sum.title, `Summary ${sIdx + 1}`);
                const unit = sum.unit ? ` (${sum.unit})` : '';
                return `
                  <tr class="fw-bold text-secondary">
                    <td colspan="${Math.max(1, cols.length - 1)}" class="text-end py-3">
                      <i class="icofont icofont-calculator-alt me-1 text-primary"></i> ${sumTitle}${unit}:
                    </td>
                    <td class="py-3 text-primary fw-bold" id="tableSummaryVal_${q.id}_${sIdx}">
                      0.00
                    </td>
                    ${allowAddRows ? `<td></td>` : ''}
                  </tr>
                `;
              }).join('')}
            </tfoot>
          ` : ''}
        </table>
      </div>
      <div class="d-flex justify-content-between align-items-center mt-3">
        <div>
          ${allowAddRows ? `
            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="addTableRow(${q.id})">
              <i class="icofont icofont-plus me-1"></i> Add Row
            </button>
          ` : ''}
        </div>
        <span class="small text-muted fw-bold" id="tableSummary_${q.id}">Total Rows: ${rowsData.length}</span>
      </div>
    `;
    return html;
  }

  // Answer Handlers
  function handleInputChange(qId, val) {
    const qObj = findQuestionById(qId);
    answerStore[qId] = {
      ...answerStore[qId],
      question_id: qId,
      excel_cell_ref: qObj ? (qObj.excel_cell_ref || '') : '',
      answer_val: val,
      category_id: activeCategory ? activeCategory.id : 0,
      label_id: activeLabel ? activeLabel.id : 0,
      sheet_name: activeCategory ? (activeCategory.sheet_name || '') : ''
    };

    let contextChanged = false;
    if (qObj) {
      const qEn = (qObj.question_en || '').toLowerCase();
      if (qObj.id === 396 || qEn.includes('reporting period start') || qEn.includes('start date')) {
        globalReportingFromDate = val ? String(val).trim() : '';
        const topFrom = document.getElementById('topFromDate');
        if (topFrom) topFrom.value = globalReportingFromDate;
        contextChanged = true;
      }
      if (qObj.id === 397 || qEn.includes('reporting period end') || qEn.includes('end date')) {
        globalReportingToDate = val ? String(val).trim() : '';
        const topTo = document.getElementById('topToDate');
        if (topTo) topTo.value = globalReportingToDate;
        contextChanged = true;
      }
      if (qObj.id === 395 || qObj.dropdown_group_name === 'currency' || qEn.includes('currency of the monetary')) {
        globalReportingCurrency = val ? String(val).trim() : '';
        const topCurrSel = document.getElementById('topCurrencySelect');
        if (topCurrSel) topCurrSel.value = globalReportingCurrency;
        contextChanged = true;
      }
    }

    markDirty();
    evaluateFormulas();
    evaluateVisibility();
    updateOverallProgress();
    updateLiveTrackerPills();

    if (contextChanged) {
      refreshAllDynamicLabels();
    }
  }

  function setBoolAnswer(qId, val, btnElem) {
    const parent = btnElem.parentElement;
    parent.querySelectorAll('.vsme-seg-btn').forEach(b => {
      b.classList.remove('active-yes', 'active-no');
    });
    if (val === 'TRUE') {
      btnElem.classList.add('active-yes');
    } else {
      btnElem.classList.add('active-no');
    }

    handleInputChange(qId, val);
  }

  function handleDropdownChange(qId, selectElem, hasCustom) {
    const dropdownVal = selectElem.value;
    if (hasCustom) {
      const customInput = document.getElementById(`customInput_${qId}`);
      const customVal = customInput ? customInput.value : '';
      const combo = JSON.stringify({ dropdown: dropdownVal, custom: customVal });
      handleInputChange(qId, combo);
    } else {
      handleInputChange(qId, dropdownVal);
    }
  }

  function handleCustomValChange(qId, customElem) {
    const card = document.getElementById(`qCard_${qId}`);
    const selectElem = card ? card.querySelector('select') : null;
    const dropdownVal = selectElem ? selectElem.value : '';
    const combo = JSON.stringify({ dropdown: dropdownVal, custom: customElem.value });
    handleInputChange(qId, combo);
  }

  function handleUrlInputChange(qId, inputElem) {
    const rawVal = inputElem.value;
    const feedbackEl = document.getElementById(`urlErr_${qId}`);
    
    if (!rawVal || rawVal.trim() === '') {
      inputElem.classList.remove('is-invalid', 'is-valid');
      if (feedbackEl) {
        feedbackEl.className = 'invalid-feedback d-none text-danger small mt-1';
      }
      handleInputChange(qId, '');
      return;
    }

    const trimmed = rawVal.trim();
    if (isValidHttpUrl(trimmed)) {
      inputElem.classList.remove('is-invalid');
      inputElem.classList.add('is-valid');
      if (feedbackEl) {
        feedbackEl.className = 'invalid-feedback d-none text-danger small mt-1';
      }
    } else {
      inputElem.classList.remove('is-valid');
      inputElem.classList.add('is-invalid');
      if (feedbackEl) {
