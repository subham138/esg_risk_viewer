  function evaluateTableSummaries(qId) {
    const qObj = findQuestionById(qId);
    if (!qObj || !qObj.table_config || !qObj.table_config.summary_rows) return;

    const summaryRows = qObj.table_config.summary_rows;
    if (summaryRows.length === 0) return;

    let rowsData = [];
    if (answerStore[qId] && answerStore[qId].answer_val) {
      try {
        rowsData = typeof answerStore[qId].answer_val === 'string' ? JSON.parse(answerStore[qId].answer_val) : answerStore[qId].answer_val;
      } catch (e) {
        rowsData = [];
      }
    }

    summaryRows.forEach((sum, sIdx) => {
      const aggType = sum.aggregate_type || 'sum';
      const targetCol = sum.target_column || 'col_2';
      let total = 0;
      let count = 0;

      if (Array.isArray(rowsData)) {
        rowsData.forEach(row => {
          const val = parseFloat(row[targetCol]);
          if (!isNaN(val)) {
            total += val;
            count++;
          }
        });
      }

      let res = total;
      if (aggType === 'avg') res = count > 0 ? (total / count) : 0;
      else if (aggType === 'count') res = count;

      const displayEl = document.getElementById(`tableSummaryVal_${qId}_${sIdx}`);
      if (displayEl) {
        displayEl.innerText = res.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      }
    });
  }

