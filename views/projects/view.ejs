    <div class="container-fluid">
        <div class="row">
            <!-- Zero Configuration  Starts-->
            <div class="col-sm-12">
                <% if(message){ %>
                    <script>
                        setTimeout(() => {
                            initiate_sweet_alert('<%= header %>', '<%= message.message %>', "<%= message.type != 'danger' ? message.type : 'error' %>")
                        }, 1000);
                    </script>
                    <!-- <div class="alert alert-<%# message.type %> dark alert-dismissible fade show" role="alert">
                  <i data-feather="clock"></i>
                  <p><%# message.message %></p>
                  <button class="btn-close" type="button" data-bs-dismiss="alert" aria-label="Close"></button>
                </div> -->
                    <% } %>

                        <%# if(!['E','EF','EV','EVF','IC','FC'].includes(dec_flag)){ %>
                            <!-- <div class="row text-center">
                                <div class="col-md-12 web-construction"></div>
                                <span style="font-size: 20px;">We are working on it. Please contact us or check back later.</span>
                            </div> -->
                        <%# }else{ %>
                            <div class="client-table-card">
                                <div class="client-dt-header">
                                    <div class="client-dt-header-left">
                                        <div class="client-search-wrapper">
                                            <svg class="client-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#667085" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="11" cy="11" r="8"></circle>
                                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                            </svg>
                                            <input type="text" id="client_search_input" class="client-search-input" placeholder="Search Projects..." autocomplete="off">
                                        </div>

                                        <div class="dropdown d-inline-block">
                                            <button class="client-btn-secondary dropdown-toggle" type="button" id="sortOrderDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M3 6h18M6 12h12M10 18h4"></path>
                                                </svg>
                                                <span id="sortOrderLabel">Sort Order</span>
                                            </button>
                                            <ul class="dropdown-menu shadow-sm" aria-labelledby="sortOrderDropdown">
                                                <li><a class="dropdown-item sort-order-opt" href="javascript:void(0)" data-col="0" data-dir="asc">Default (#)</a></li>
                                                <li><a class="dropdown-item sort-order-opt" href="javascript:void(0)" data-col="1" data-dir="asc">Project Name (A-Z)</a></li>
                                                <li><a class="dropdown-item sort-order-opt" href="javascript:void(0)" data-col="1" data-dir="desc">Project Name (Z-A)</a></li>
                                                <li><a class="dropdown-item sort-order-opt" href="javascript:void(0)" data-col="3" data-dir="desc">Recent Access</a></li>
                                            </ul>
                                        </div>
                                    </div>

                                    <div class="client-dt-header-right">
                                        <% if(user_type=='A' || user_type=='C' || user_type=='S' ){ %>
                                            <% if(canAddNewProject){ %>
                                                <a href="/my_project_add?flag=<%= enc_dt %>" class="client-btn-primary" data-bs-toggle="tooltip"
                                                    data-bs-placement="left" title="" data-bs-original-title="Edit" id="my_project_add" data-step="1">
                                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                                    </svg>
                                                    <%= lang.view.add_btn_name %>
                                                </a>
                                            <% }else{ %>
                                                <button onclick="openNewWindow('P')" class="client-btn-primary" data-bs-toggle="tooltip"
                                                    data-bs-placement="left" title="" data-bs-original-title="Edit">
                                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                                    </svg>
                                                    <%= lang.view.add_btn_name %>
                                                </button>
                                            <% } %>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="client-table-responsive">
                                    <table class="table" id="project_table">
                                        <thead>
                                            <tr>
                                                <th style="width: 50px;">#</th>
                                                <th>
                                                    <%= lang.view.table.head1 %>
                                                </th>
                                                <th>
                                                    <%= lang.view.table.head3 %>
                                                </th>
                                                <th>
                                                    <%= lang.view.table.head2 %>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% if(project_data.msg.length> 0){
                                                let i = 1;
                                                project_data.msg.forEach(dt => {
                                                    var isDisable = false
                                                    if(i>capacity) isDisable=true %>
                                                <tr>
                                                    <td>
                                                        <span class="client-row-index"><%= i %></span>
                                                    </td>
                                                    <td>
                                                        <div class="client-project-cell">
                                                            <div class="client-project-avatar">
                                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                                                </svg>
                                                            </div>
                                                            <div class="client-project-info">
                                                                <span class="client-project-name"><%= dt.project_name %></span>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td <% if(i==1){ %> id="my_project_td" <% } %>>
                                                        <div class="client-actions-group">
                                                            <% if(user_type=='A' || user_type=='C' || user_type=='S' ){
                                                                if(!isDisable){ %>
                                                                    <a href="/my_project_add?id=<%= dt.id %>&flag=<%= enc_dt %>"
                                                                        class="client-btn-action" data-bs-toggle="tooltip" data-bs-placement="left"
                                                                        title="" data-bs-original-title="Edit">
                                                                        <i class="icofont icofont-ui-edit"></i>
                                                                        <%= lang.view.edit_btn %>
                                                                    </a>
                                                                <% }else{ %>
                                                                    <a class="client-btn-action" data-bs-toggle="tooltip" data-bs-placement="left"
                                                                        title="" data-bs-original-title="Edit" onclick="openNewWindow('P')">
                                                                        <i class="icofont icofont-ui-edit"></i>
                                                                        <%= lang.view.edit_btn %>
                                                                    </a>
                                                                <% } %>
                                                            <% } %>
                                                            <a class="client-btn-action client-btn-manage"
                                                                onclick="redirectToPage('<%= dt.id %>', '<%= dt.sec_id > 0 ? dt.sec_id : 0 %>', '<%= dt.ind_id > 0 ? dt.ind_id : 0 %>', '<%= dt.project_name %>', `<%= ['IC', 'FC'].includes(dec_flag) ? 'cal_proj_report_view' : 'project_report_view' %>`, '<%= isDisable %>')">
                                                                <% if(user_type !='V' ){ %>
                                                                    <i class="icofont icofont-ui-settings"></i>
                                                                    <%= lang.view.manage_btn %>
                                                                <% }else{ %>
                                                                    <i class="icofont icofont-eye-alt"></i>
                                                                    <%= lang.view.manage_btn %>
                                                                <% } %>
                                                            </a>
                                                            <a class="client-btn-action client-btn-view"
                                                                onclick="redirectToPage('<%= dt.id %>', '<%= dt.sec_id > 0 ? dt.sec_id : 0 %>', '<%= dt.ind_id > 0 ? dt.ind_id : 0 %>', '<%= dt.project_name %>', `<%= ['IC', 'FC'].includes(dec_flag) ? 'cal_report_full_view' : 'report_full_view' %>`, '<%= isDisable %>')">
                                                                <i class="icofont icofont-eye-alt"></i>
                                                                <%= lang.view.view_btn %>
                                                            </a>
                                                            <% if(!isDisable){ %>
                                                                <a href="/deactive_project?id=<%= dt.id %>&flag=<%= enc_dt %>" class="client-btn-action client-btn-delete" data-bs-toggle="tooltip" data-bs-placement="left" title="" data-bs-original-title="Delete" onclick="return checkDel()">
                                                                    <i class="icofont icofont-ui-delete"></i> 
                                                                    <%= lang.view.delete_btn %>
                                                                </a>
                                                            <% }else { %>
                                                                <a class="client-btn-action client-btn-delete"
                                                                    data-bs-toggle="tooltip" data-bs-placement="left" title="" data-bs-original-title="Delete"
                                                                    onclick="openNewWindow('P')">
                                                                    <i class="icofont icofont-ui-delete"></i>
                                                                    <%= lang.view.delete_btn %>
                                                                </a>
                                                            <% } %>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="client-date-text">
                                                            <%= dt.last_access !='' ? dateFormat(dt.last_access, 'dd/mm/yyyy HH:MM:ss' ) : '' %>
                                                        </span>
                                                    </td>
                                                </tr>
                                                <% i++; })}else{ %>
                                                    <tr>
                                                        <td class="text-center text-muted" colspan="4">No Data Found</td>
                                                    </tr>
                                                    <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        <%# } %>

            </div>
            <!-- Zero Configuration  Ends-->
        </div>
    </div>
    <script>
        function redirectToPage(id, sec_id, ind_id, proj_name, route, isDisabled='false') {
            if(isDisabled != 'true'){
                var decFlag = '<%= dec_flag %>';
                var encFlag = '<%= enc_dt %>';
                var isVsme = (decFlag === 'EV' || decFlag === 'EVF' || encFlag === 'RVY%3D' || encFlag === 'RVY=' || encFlag === 'RVZG');

                if (isVsme && (route === 'project_report_view' || route === 'cal_proj_report_view')) {
                    window.location.href = `/vsme/questionnaire?project_id=${id}&flag=${encodeURIComponent(encFlag)}`;
                    return;
                }

                // VSME Preview button → XBRL preview page
                if (isVsme && (route === 'report_full_view' || route === 'cal_report_full_view')) {
                    window.location.href = `/vsme/xbrl-preview?project_id=${id}&flag=${encodeURIComponent(encFlag)}`;
                    return;
                }

                if (sec_id > 0 && ind_id > 0) {
                    window.location.href = `/${route}?enc_data=${window.btoa(JSON.stringify({ sec_id: sec_id, ind_id: ind_id, top_id: 0, proj_id: id, proj_name: proj_name, repo_type: '<%= flag == "I" ? "ifrs" : (flag == "E" ? "esrs" : (flag == "G" ? "gri" : "gri-f")) %>', flag: '<%= flag %>', dec_flag: '<%= dec_flag %>' }))}`
                } else {
                    if (isVsme) {
                        window.location.href = `/vsme/questionnaire?project_id=${id}&flag=${encodeURIComponent(encFlag)}`;
                    } else {
                        window.location.href = `/my_project_add?id=${id}&flag=<%= enc_dt %>`
                    }
                }
            }else{
                openNewWindow('P')
            }
        }

        var projTable;
        $(document).ready(function () {
            projTable = $('#project_table').DataTable({
                dom: 't<"client-dt-footer"<"client-dt-footer-left"l><"client-dt-footer-right"ip>>',
                paging: true,
                ordering: true,
                info: true,
                pageLength: 5,
                lengthMenu: [5, 10, 25, 50],
                language: {
                    lengthMenu: "Rows per page _MENU_",
                    info: "_START_ - _END_ of _TOTAL_",
                    infoEmpty: "0 - 0 of 0",
                    infoFiltered: "(filtered from _MAX_)",
                    paginate: {
                        previous: '<i class="icofont icofont-rounded-left"></i>',
                        next: '<i class="icofont icofont-rounded-right"></i>'
                    }
                },
                columnDefs: [
                    { orderable: false, targets: [2] }
                ]
            });

            $('#client_search_input').on('keyup input', function() {
                projTable.search(this.value).draw();
            });

            $('.sort-order-opt').on('click', function() {
                var col = $(this).data('col');
                var dir = $(this).data('dir');
                $('.sort-order-opt').removeClass('active');
                $(this).addClass('active');
                $('#sortOrderLabel').text($(this).text());
                projTable.order([col, dir]).draw();
            });

            var element = [document.querySelector('#my_project_add'), document.querySelector('#my_project_td')],
                text = [`Create a new project under any reporting framework.`, `“Edit” allows you to change project name, assign new users or delete existing users for this project. “Manage” allows you to manage this project. “View” allows you to preview and download the project report.`];
            // setTimeout(() => {
            //     triggerTour(element, text)
            // }, 200);
        });
    </script>
    <%- include('../templates/footer.ejs') %>