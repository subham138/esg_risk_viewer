                      <span class="user-dd-text">Knowledgebase</span>
                    </a>
                    <a href="/support" class="user-dd-item">
                      <i data-feather="headphones" class="user-dd-icon"></i>
                      <span class="user-dd-text">Support</span>
                    </a>
                  </div>

