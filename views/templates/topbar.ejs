              <li class="onhover-dropdown user-profile-dropdown">
                <% 
                  var userNameParts = user.user_name ? user.user_name.trim().split(/\s+/) : [];
                  var userInitials = 'U';
                  if (userNameParts.length > 1) {
                    userInitials = (Array.from(userNameParts[0])[0] + Array.from(userNameParts[userNameParts.length - 1])[0]).toUpperCase();
                  } else if (userNameParts.length === 1 && userNameParts[0].length > 0) {
                    userInitials = Array.from(userNameParts[0])[0].toUpperCase();
                  }
                %>
                <div class="<%= user.plan_is_active != 'N' ? 'profile-ring' : 'circle' %>">
                  <span class="<%= user.plan_is_active != 'N' ? 'profile-initials' : 'initials' %>">
                    <%= userInitials %>
                  </span>
                </div>

                <div class="user-profile-menu onhover-show-div">
                  <!-- User Profile Info -->
                  <div class="user-dd-header">
                    <div class="user-dd-avatar">
                      <span class="user-dd-avatar-letters"><%= userInitials %></span>
                    </div>
                    <div class="user-dd-info">
                      <div class="user-dd-name-row">
                        <span class="user-dd-name" title="<%= user.user_name %>"><%= user.user_name %></span>
                        <span class="user-dd-badge-pro"><%= user.plan_name ? user.plan_name : (user.plan_is_active != 'N' ? 'Pro' : 'Pro') %></span>
                      </div>
                      <div class="user-dd-email" title="<%= user.user_id %>">
                        <%= user.user_id && user.user_id.includes('@') ? user.user_id : (user.email_id || user.user_id || 'robert@kt.com') %>
                      </div>
                    </div>
                  </div>

                  <div class="user-dd-divider"></div>

                  <!-- Account settings -->
                  <div class="user-dd-section">
                    <div class="user-dd-category">Account settings</div>
                    <a href="/subscription" class="user-dd-item">
                      <i data-feather="credit-card" class="user-dd-icon"></i>
                      <span class="user-dd-text">My subscriptions</span>
                    </a>
                    <a href="/profile-security" class="user-dd-item">
                      <i data-feather="user" class="user-dd-icon"></i>
                      <span class="user-dd-text">Profile and security</span>
                    </a>
                    <a href="/message-settings" class="user-dd-item">
                      <i data-feather="mail" class="user-dd-icon"></i>
                      <span class="user-dd-text">Message settings</span>
                    </a>
                  </div>

                  <div class="user-dd-divider"></div>

                  <!-- Help and support -->
